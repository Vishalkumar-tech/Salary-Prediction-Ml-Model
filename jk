<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
/* =========================================================
   CHART GLOBAL DEFAULTS
========================================================= */
Chart.defaults.font.family =
  "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif";
Chart.defaults.font.size = 12;
Chart.defaults.color = "#64748b";

/* =========================================================
   STATE
========================================================= */
let skuMonthlyChartInstance = null;
let skuYearlyBarChartInstance = null;
let dashboardData = null;

const state = {
  months: [],
  points: [],
  sku: "",
  tolerance: 2,        // absolute percent value (0..5)
  toleranceSign: "+",  // not used directly; UI shows both ±
  kpiData: [],
  busy: false
};

/* =========================================================
   HELPERS
========================================================= */
function n(v, d = 2) {
  const x = Number(v);
  return Number.isFinite(x) ? x.toFixed(d) : "—";
}
function signed(v, d = 3) {
  const x = Number(v);
  if (!Number.isFinite(x)) return "—";
  return (x >= 0 ? "+" : "") + x.toFixed(d);
}
function escapeHtml(value) {
  return String(value == null ? "" : value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}
function formatMonthLabel(value) {
  const m = String(value || "").match(/^(\d{4})-(\d{2})$/);
  if (!m) return value;
  const names = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return names[Number(m[2]) - 1] + "-" + m[1].slice(2);
}
function mean(arr) {
  const vals = arr.filter(v => Number.isFinite(v));
  if (!vals.length) return null;
  return vals.reduce((a, b) => a + b, 0) / vals.length;
}
function safeFileBase(name) {
  return String(name || "SKU").replace(/[^\w\-\.]+/g, "_");
}
function triggerDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 500);
}
function setBusy(flag, label) {
  state.busy = flag;
  ["exportCsvBtn","exportWordBtn","exportPdfBtn"].forEach(id => {
    const b = document.getElementById(id);
    if (!b) return;
    b.disabled = flag;
    if (flag && label && b.dataset.kind === label) {
      b.dataset.originalText = b.dataset.originalText || b.innerHTML;
      b.innerHTML = '<span class="spinner" style="border-color:currentColor;border-top-color:transparent;"></span> Preparing…';
    } else if (!flag && b.dataset.originalText) {
      b.innerHTML = b.dataset.originalText;
      delete b.dataset.originalText;
    }
  });
}

/* =========================================================
   TOLERANCE MATH
   Computes lower/upper bound from spec & selected %.
   Falls back to supplied ±2% fields when tolerance = 2.
========================================================= */
function getTolerance() {
  return Number(state.tolerance) || 0;
}
function toleranceLabel() {
  const t = getTolerance();
  const sign = t > 0 ? "+" : t < 0 ? "−" : "";
  return sign + Math.abs(t) + "%";
}
function toleranceLabelBare() {
  return Math.abs(getTolerance()) + "%";
}
function lowerBound(spec) {
  const s = Number(spec);
  if (!Number.isFinite(s)) return null;
  return s * (1 - getTolerance() / 100);
}
function upperBound(spec) {
  const s = Number(spec);
  if (!Number.isFinite(s)) return null;
  return s * (1 + getTolerance() / 100);
}
/* Returns { lo, hi } for a given row — uses supplied fields when tol=2,
   otherwise computes from spec. */
function boundsForRow(r) {
  if (!r) return { lo: null, hi: null };
  const spec = r.spec == null ? null : Number(r.spec);
  const tol = getTolerance();
  if (tol === 2) {
    const lo = r.minus_2_percent == null ? null : Number(r.minus_2_percent);
    const hi = r.plus_2_percent  == null ? null : Number(r.plus_2_percent);
    if (Number.isFinite(lo) && Number.isFinite(hi)) return { lo, hi };
  }
  return { lo: lowerBound(spec), hi: upperBound(spec) };
}
function isWithin(r) {
  if (!r) return null;
  const run = r.average_running_weight == null ? null : Number(r.average_running_weight);
  if (!Number.isFinite(run)) return null;
  const { lo, hi } = boundsForRow(r);
  if (Number.isFinite(lo) && Number.isFinite(hi)) {
    return run >= Math.min(lo, hi) && run <= Math.max(lo, hi);
  }
  return null;
}

/* =========================================================
   FILTERS
========================================================= */
function populateFilters(data) {
  const skuSelect = document.getElementById("skuSelect");
  const from = document.getElementById("fromMonth");
  const to = document.getElementById("toMonth");
  if (!skuSelect || !from || !to) return;

  const skus = data.sku_values || data.skus || [];
  const months =
    data.continuous_months || data.month_values ||
    (data.meta && data.meta.months) || [];

  skuSelect.innerHTML = skus.length
    ? skus.map(x => `<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`).join("")
    : `<option value="">No SKU found</option>`;

  const opts = months
    .map(x => `<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`)
    .join("");
  from.innerHTML = opts;
  to.innerHTML = opts;

  if (months.length) {
    from.value = months[0];
    to.value = months[months.length - 1];
  }
  if (skus.length) skuSelect.value = skus[0];
}

/* =========================================================
   TOLERANCE CONTROL
========================================================= */
function buildToleranceControl() {
  const wrap = document.getElementById("toleranceWrap");
  if (!wrap) return;

  const values = [0, 1, 2, 3, 4, 5]; // absolute percentages
  wrap.innerHTML = values.map(v => {
    const label = v === 0 ? "0%" : "±" + v + "%";
    const active = Number(state.tolerance) === v ? " active" : "";
    return '<button type="button" class="tol-btn' + active +
           '" data-value="' + v + '" aria-pressed="' + (active ? "true" : "false") + '">' +
           label + '</button>';
  }).join("");

  wrap.querySelectorAll(".tol-btn").forEach(btn => {
    btn.addEventListener("click", function () {
      const v = Number(this.dataset.value);
      if (!Number.isFinite(v)) return;
      state.tolerance = v;
      wrap.querySelectorAll(".tol-btn").forEach(b => {
        const active = Number(b.dataset.value) === v;
        b.classList.toggle("active", active);
        b.setAttribute("aria-pressed", active ? "true" : "false");
      });
      renderSkuAnalysis();
    });
  });
}

/* =========================================================
   KPI
========================================================= */
function kpiIcon(tone) {
  if (tone === "is-ok")
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  if (tone === "is-bad")
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
  if (tone === "is-info")
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>';
}

function computeKpis(selected, points) {
  const withData = points.filter(Boolean);
  const specVals = withData.map(r => r.spec == null ? null : Number(r.spec)).filter(Number.isFinite);
  const avgVals = withData.map(r => r.average_running_weight == null ? null : Number(r.average_running_weight)).filter(Number.isFinite);

  const avgSpec = mean(specVals);
  const avgRun = mean(avgVals);

  let devKg = null, devPct = null;
  if (avgSpec != null && avgRun != null && avgSpec !== 0) {
    devKg = avgRun - avgSpec;
    devPct = (devKg / avgSpec) * 100;
  }

  let within = 0, evaluated = 0;
  withData.forEach(r => {
    const run = r.average_running_weight == null ? null : Number(r.average_running_weight);
    if (!Number.isFinite(run)) return;
    evaluated++;
    const ok = isWithin(r);
    if (ok === true) within++;
  });

  const compliance = evaluated ? (within / evaluated) * 100 : null;
  const tol = getTolerance();
  const devTone = devPct == null ? "is-neutral"
    : Math.abs(devPct) <= tol ? "is-ok" : "is-bad";
  const compTone = compliance == null ? "is-neutral"
    : compliance >= 80 ? "is-ok" : "is-bad";

  return [
    { label: "Average Spec", value: avgSpec == null ? "—" : n(avgSpec, 3), unit: "kg",
      sub: specVals.length + " month" + (specVals.length === 1 ? "" : "s") + " with spec", tone: "is-neutral" },
    { label: "Avg Running Weight", value: avgRun == null ? "—" : n(avgRun, 3), unit: "kg",
      sub: avgVals.length + " month" + (avgVals.length === 1 ? "" : "s") + " with actuals", tone: "is-info" },
    { label: "Deviation", value: devPct == null ? "—" : (devPct >= 0 ? "+" : "") + devPct.toFixed(2), unit: "%",
      sub: devKg == null ? "—" : signed(devKg, 3) + " kg vs spec", tone: devTone },
    { label: "Months Covered", value: String(withData.length), unit: "/ " + selected.length,
      sub: selected.length - withData.length > 0
        ? (selected.length - withData.length) + " month(s) missing"
        : "Complete coverage", tone: "is-neutral" },
    { label: "Within " + toleranceLabel(), value: compliance == null ? "—" : compliance.toFixed(1), unit: "%",
      sub: within + " of " + evaluated + " month(s)", tone: compTone }
  ];
}

function renderKpis(selected, points) {
  const grid = document.getElementById("kpiGrid");
  if (!grid) return;
  const cards = computeKpis(selected, points);
  state.kpiData = cards;
  grid.innerHTML = cards.map(c =>
    '<div class="kpi ' + c.tone + '">' +
      '<div class="kpi-top">' +
        '<div class="kpi-label">' + escapeHtml(c.label) + '</div>' +
        '<div class="kpi-icon">' + kpiIcon(c.tone) + '</div>' +
      '</div>' +
      '<div class="kpi-value">' + escapeHtml(c.value) +
        '<span class="unit">' + escapeHtml(c.unit) + '</span>' +
      '</div>' +
      '<div class="kpi-sub">' + escapeHtml(c.sub) + '</div>' +
    '</div>'
  ).join("");
}

/* =========================================================
   CHART 1 — Monthly Trend (Line) with tolerance band
========================================================= */
function renderLineChart(selected, points) {
  const ctx = document.getElementById("skuMonthlyChart");
  if (!ctx) return;
  if (skuMonthlyChartInstance) skuMonthlyChartInstance.destroy();

  const tol = getTolerance();
  const missing = points.map((r, i) => (r ? null : i)).filter(i => i !== null);

  /* Compute tolerance lines from spec for each month */
  const loData = points.map(r => {
    if (!r) return null;
    const spec = r.spec == null ? null : Number(r.spec);
    if (!Number.isFinite(spec)) return null;
    return Number((spec * (1 - tol / 100)).toFixed(4));
  });
  const hiData = points.map(r => {
    if (!r) return null;
    const spec = r.spec == null ? null : Number(r.spec);
    if (!Number.isFinite(spec)) return null;
    return Number((spec * (1 + tol / 100)).toFixed(4));
  });

  /* Tolerance band plugin (fill between lo and hi) */
  const bandPlugin = {
    id: "toleranceBand",
    beforeDatasetsDraw(chart) {
      const { ctx, chartArea, scales } = chart;
      if (!scales.x || !scales.y) return;

      const loDataset = chart.data.datasets.find(d => d.label === "__lo");
      const hiDataset = chart.data.datasets.find(d => d.label === "__hi");
      if (!loDataset || !hiDataset) return;

      const lo = loDataset.data;
      const hi = hiDataset.data;
      const xs = chart.data.labels.map((_, i) => scales.x.getPixelForValue(i));

      ctx.save();
      ctx.beginPath();
      let started = false;
      let firstX = null, lastX = null;

      // top edge (hi)
      hi.forEach((v, i) => {
        if (v == null || !Number.isFinite(v)) return;
        const x = xs[i];
        const y = scales.y.getPixelForValue(v);
        if (!started) { ctx.moveTo(x, y); started = true; }
        else ctx.lineTo(x, y);
        if (firstX == null) firstX = x;
        lastX = x;
      });
      // bottom edge (lo) reversed
      for (let i = lo.length - 1; i >= 0; i--) {
        const v = lo[i];
        if (v == null || !Number.isFinite(v)) continue;
        const x = xs[i];
        const y = scales.y.getPixelForValue(v);
        ctx.lineTo(x, y);
      }
      ctx.closePath();

      const grad = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
      grad.addColorStop(0, "rgba(227,6,19,.09)");
      grad.addColorStop(1, "rgba(227,6,19,.03)");
      ctx.fillStyle = grad;
      ctx.fill();
      ctx.restore();
    }
  };

  const missingPlugin = {
    id: "missingMonthIndicator",
    afterDatasetsDraw(chart) {
      if (!missing.length || !chart.scales.x) return;
      const c = chart.ctx;
      c.save();
      c.font = "700 11px Inter, Arial";
      c.textAlign = "center";
      c.fillStyle = "#94a3b8";
      missing.forEach(i => {
        const x = chart.scales.x.getPixelForValue(i);
        c.setLineDash([5, 5]);
        c.strokeStyle = "#cbd5e1";
        c.beginPath();
        c.moveTo(x, chart.chartArea.top);
        c.lineTo(x, chart.chartArea.bottom);
        c.stroke();
        c.setLineDash([]);
        c.fillText("No data", x, chart.chartArea.top + 16);
      });
      c.restore();
    }
  };

  const tolLabel = "±" + tol + "%";
  const tolLabelLow = "−" + tol + "%";
  const tolLabelHigh = "+" + tol + "%";

  skuMonthlyChartInstance = new Chart(ctx, {
    type: "line",
    plugins: [bandPlugin, missingPlugin],
    data: {
      labels: selected.map(formatMonthLabel),
      datasets: [
        {
          label: "Average Running Weight",
          data: points.map(r => r ? Number(r.average_running_weight) : null),
          borderColor: "#e30613",
          backgroundColor: "rgba(227,6,19,.06)",
          borderWidth: 3,
          spanGaps: true,
          tension: 0.28,
          pointRadius: 5,
          pointHoverRadius: 9,
          pointBackgroundColor: "#e30613",
          pointBorderColor: "#ffffff",
          pointBorderWidth: 2.5,
          pointHoverBorderWidth: 3,
          fill: false,
          order: 1
        },
        {
          label: "Spec",
          data: points.map(r => r ? Number(r.spec) : null),
          borderColor: "#0f172a",
          backgroundColor: "#0f172a",
          borderWidth: 2,
          borderDash: [6, 4],
          spanGaps: true,
          tension: 0.2,
          pointRadius: 3,
          pointHoverRadius: 6,
          pointBackgroundColor: "#0f172a",
          pointBorderColor: "#ffffff",
          pointBorderWidth: 2,
          fill: false,
          order: 2
        },
        /* Hidden helper datasets for band fill */
        {
          label: "__lo",
          data: loData,
          borderColor: "transparent",
          backgroundColor: "transparent",
          borderWidth: 0,
          pointRadius: 0,
          spanGaps: true,
          tension: 0.2,
          fill: false,
          hidden: true,
          order: 99
        },
        {
          label: "__hi",
          data: hiData,
          borderColor: "transparent",
          backgroundColor: "transparent",
          borderWidth: 0,
          pointRadius: 0,
          spanGaps: true,
          tension: 0.2,
          fill: false,
          hidden: true,
          order: 100
        },
        /* Visible tolerance limit lines */
        {
          label: tolLabelLow + " Limit",
          data: loData,
          borderColor: "#f59e0b",
          backgroundColor: "#f59e0b",
          borderWidth: 1.8,
          borderDash: [3, 3],
          spanGaps: true,
          tension: 0.2,
          pointRadius: 2,
          pointHoverRadius: 5,
          pointBackgroundColor: "#f59e0b",
          fill: false,
          order: 3
        },
        {
          label: tolLabelHigh + " Limit",
          data: hiData,
          borderColor: "#2563eb",
          backgroundColor: "#2563eb",
          borderWidth: 1.8,
          borderDash: [3, 3],
          spanGaps: true,
          tension: 0.2,
          pointRadius: 2,
          pointHoverRadius: 5,
          pointBackgroundColor: "#2563eb",
          fill: false,
          order: 4
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: "index", intersect: false },
      animation: { duration: 900, easing: "easeOutQuart" },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: "#64748b", font: { weight: "600", size: 11.5 } }
        },
        y: {
          grid: { color: "#eef2f7" },
          ticks: { color: "#64748b", font: { weight: "600", size: 11.5 } },
          title: {
            display: true, text: "Weight (kg)",
            color: "#475569", font: { weight: "700", size: 12 }
          }
        }
      },
      plugins: {
        legend: {
          display: true, position: "top", align: "end",
          labels: {
            usePointStyle: true, pointStyle: "line",
            boxWidth: 26, padding: 18,
            color: "#334155", font: { weight: "700", size: 12 },
            filter: (item) => !item.text.startsWith("__")
          }
        },
        tooltip: {
          backgroundColor: "#0b1220",
          padding: 14, cornerRadius: 10,
          titleFont: { weight: "800", size: 13 },
          bodyFont: { weight: "600", size: 12.5 },
          bodySpacing: 6, boxPadding: 6,
          borderColor: "rgba(255,255,255,.08)", borderWidth: 1,
          filter: (item) => !item.dataset.label.startsWith("__")
        }
      }
    }
  });
}

/* =========================================================
   CHART 2 — Monthly vs Full-Year Average (Bar)
========================================================= */
function renderBarChart(selected, points) {
  const ctx = document.getElementById("skuYearlyBarChart");
  if (!ctx) return;
  if (skuYearlyBarChartInstance) skuYearlyBarChartInstance.destroy();

  const avgVals = points.filter(Boolean)
    .map(r => r.average_running_weight == null ? null : Number(r.average_running_weight))
    .filter(Number.isFinite);
  const yearAvg = mean(avgVals);

  const colors = points.map(r => {
    if (!r) return "rgba(203,213,225,.55)";
    const ok = isWithin(r);
    if (ok === true)  return "rgba(5,150,105,.85)";
    if (ok === false) return "rgba(220,38,38,.85)";
    return "rgba(148,163,184,.85)";
  });

  const borders = points.map(r => {
    if (!r) return "rgba(148,163,184,.6)";
    const ok = isWithin(r);
    if (ok === true)  return "#059669";
    if (ok === false) return "#dc2626";
    return "#94a3b8";
  });

  const yearlyLinePlugin = {
    id: "yearlyAverageLine",
    afterDatasetsDraw(chart) {
      if (yearAvg == null) return;
      const yScale = chart.scales.y;
      const y = yScale.getPixelForValue(yearAvg);
      const c = chart.ctx;
      c.save();
      c.setLineDash([7, 5]);
      c.strokeStyle = "#0f172a";
      c.lineWidth = 1.8;
      c.beginPath();
      c.moveTo(chart.chartArea.left, y);
      c.lineTo(chart.chartArea.right, y);
      c.stroke();
      c.setLineDash([]);

      const label = "Full-Year Avg  " + yearAvg.toFixed(3) + " kg";
      c.font = "800 11px Inter, Arial";
      const tw = c.measureText(label).width;
      const bx = chart.chartArea.right - tw - 22;
      const by = y - 22;
      c.fillStyle = "#ffffff";
      c.strokeStyle = "#e5eaf2";
      c.lineWidth = 1;
      c.beginPath();
      if (c.roundRect) c.roundRect(bx, by, tw + 16, 20, 8);
      else c.rect(bx, by, tw + 16, 20);
      c.fill(); c.stroke();

      c.fillStyle = "#0f172a";
      c.fillText(label, bx + 8, by + 14);
      c.restore();
    }
  };

  skuYearlyBarChartInstance = new Chart(ctx, {
    type: "bar",
    plugins: [yearlyLinePlugin],
    data: {
      labels: selected.map(formatMonthLabel),
      datasets: [{
