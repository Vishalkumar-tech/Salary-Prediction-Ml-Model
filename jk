\========================================================= \*/



function renderSkuAnalysis() {



    if (!dashboardData) return;



    const skuEl = document.getElementById("skuSelect");

    const fromEl = document.getElementById("fromMonth");

    const toEl = document.getElementById("toMonth");



    if (!skuEl || !fromEl || !toEl) return;



    const sku = skuEl.value;

    const from = fromEl.value;

    const to = toEl.value;



    const allMonths =

        dashboardData.continuous_months ||

        dashboardData.month_values ||

        [];



    const monthly = dashboardData.sku_month_summary || [];



    const rows = monthly.filter(r => String(r.sku || "") === String(sku));



    let start = allMonths.indexOf(from);

    let end = allMonths.indexOf(to);



    if (start < 0) start = 0;

    if (end < 0) end = allMonths.length - 1;



    if (start > end) {

        const t = start; start = end; end = t;

    }



    const selected = allMonths.slice(start, end + 1);



    const byMonth = new Map(rows.map(r => [String(r.month), r]));



    const points = selected.map(m => byMonth.get(String(m)) || null);



    const missing = points

        .map((r, i) => (r ? null : i))

        .filter(i => i !== null);



    const title = document.getElementById("skuSelectedTitle");

    if (title) title.textContent = sku ? \`Size / SKU: ${sku}\` : "Select a SKU";



    const info = document.getElementById("skuMissingInfo");



    if (info) {



        info.style.display = missing.length ? "block" : "none";



        info.textContent = missing.length

            ? \`Missing month data: ${missing.map(i => formatMonthLabel(selected[i])).join(", ")}. \` +

              \`These months remain on the graph and are not treated as 0.\`

            : "All selected months contain data.";

    }



    const ctx = document.getElementById("skuMonthlyChart");



    if (ctx) {



        if (skuMonthlyChartInstance) skuMonthlyChartInstance.destroy();



        const missingPlugin = {

            id: "missingMonthIndicator",

            afterDraw(chart) {



                if (!missing.length || !chart.scales.x) return;



                const c = chart.ctx;



                c.save();

                c.font = "700 11px Inter, Arial";

                c.textAlign = "center";

                c.fillStyle = "#94a3b8";



                missing.forEach(i => {



                    const x = chart.scales.x.getPixelForValue(i);



                    c.setLineDash([5, 5]);

                    c.strokeStyle = "#cbd5e1";

                    c.beginPath();

                    c.moveTo(x, chart.chartArea.top);

                    c.lineTo(x, chart.chartArea.bottom);

                    c.stroke();

                    c.setLineDash([]);



                    c.fillText("No data", x, chart.chartArea.top + 16);

                });



                c.restore();

            }

        };



        skuMonthlyChartInstance = new Chart(ctx, {

            type: "line",

            plugins: [missingPlugin],

            data: {

                labels: selected.map(formatMonthLabel),

                datasets: [

                    {

                        label: "Average Running Weight",

                        data: points.map(r => r ? Number(r.average_running_weight) : null),

                        borderColor: "#e30613",

                        backgroundColor: "#e30613",

                        borderWidth: 3,

                        spanGaps: true,

                        tension: 0.25,

                        pointRadius: 5,

                        pointHoverRadius: 9,

                        pointBackgroundColor: "#e30613",

                        pointBorderColor: "#ffffff",

                        pointBorderWidth: 2.5,

                        pointHoverBorderWidth: 3,

                        fill: false

                    },

                    {

                        label: "Spec",

                        data: points.map(r => r ? Number(r.spec) : null),

                        borderColor: "#0f172a",

                        backgroundColor: "#0f172a",

                        borderWidth: 2,

                        borderDash: [6, 4],

                        spanGaps: true,

                        tension: 0.2,

                        pointRadius: 3,

                        pointHoverRadius: 6,

                        pointBackgroundColor: "#0f172a",

                        pointBorderColor: "#ffffff",

                        pointBorderWidth: 2,

                        fill: false

                    },

                    {

                        label: "-2% Limit",

                        data: points.map(r =>

                            r && r.minus_2_percent != null

                                ? Number(r.minus_2_percent)

                                : null

                        ),

                        borderColor: "#f59e0b",

                        backgroundColor: "#f59e0b",

                        borderWidth: 1.8,

                        borderDash: [3, 3],

                        spanGaps: true,

                        tension: 0.2,

                        pointRadius: 2,

                        pointHoverRadius: 5,

                        pointBackgroundColor: "#f59e0b",

                        fill: false

                    },

                    {

                        label: "+2% Limit",

                        data: points.map(r =>

                            r && r.plus_2_percent != null

                                ? Number(r.plus_2_percent)

                                : null

                        ),

                        borderColor: "#2563eb",

                        backgroundColor: "#2563eb",

                        borderWidth: 1.8,

                        borderDash: [3, 3],

                        spanGaps: true,

                        tension: 0.2,

                        pointRadius: 2,

                        pointHoverRadius: 5,

                        pointBackgroundColor: "#2563eb",

                        fill: false

                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: { mode: "index", intersect: false },

                animation: {

                    duration: 900,

                    easing: "easeOutQuart"

                },

                scales: {

                    x: {

                        grid: { display: false },

                        ticks: {

                            color: "#64748b",

                            font: { weight: "600", size: 11.5 }

                        }

                    },

                    y: {

                        grid: { color: "#eef2f7" },

                        ticks: {

                            color: "#64748b",

                            font: { weight: "600", size: 11.5 }

                        },

                        title: {

                            display: true,

                            text: "Weight (KG)",

                            color: "#475569",

                            font: { weight: "700", size: 12 }

                        }

                    }

                },

                plugins: {

