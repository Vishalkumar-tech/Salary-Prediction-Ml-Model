              '<img src="' + barImg + '" class="chart-img" alt="Monthly Average">' : "") +

    '<h2>4. Month-wise Detail</h2>' +
    '<table><thead><tr>' +
      '<th>Month</th>' +
      '<th style="text-align:right;">Spec (kg)</th>' +
      '<th style="text-align:right;">Avg Running Weight (kg)</th>' +
      '<th style="text-align:right;">Deviation</th>' +
      '<th style="text-align:right;">Lower (' + escapeHtml(limitLabel) + ')</th>' +
      '<th style="text-align:right;">Upper (' + escapeHtml(limitLabel) + ')</th>' +
      '<th style="text-align:center;">Status</th>' +
    '</tr></thead><tbody>' + tableRows + '</tbody></table>' +

    '<p style="font-size:9pt;color:#b5b0c4;margin-top:12pt;">' +
      'Supplied Spec, Actual, bucket counts, Total tyres and % adher. values are displayed ' +
      'exactly as received — no recalculation is performed. Missing months are shown as ' +
      '"No data" and are excluded from all averages.' +
    '</p>' +

    '<div class="footer">JK Tyre · SKU Monthly Running Weight Analysis · ' +
      'Supplied data is displayed as-is without recalculation.</div>' +

    '</body></html>';

  const blob = new Blob(["\ufeff", html], { type: "application/msword" });
  triggerDownload(blob, "JK-" + safeFileBase(state.sku) + "-running-weight.doc");
}

/* =========================================================
   EXPORT 3 — PDF
========================================================= */
function buildPrintDoc() {
  const T = theme();
  const limit = state.limit;
  const sign = limit > 0 ? "+" : "";
  const limitLabel = sign + limit + "%";

  const lineSvg = document.querySelector("#skuMonthlyChart svg");
  const barSvg  = document.querySelector("#skuYearlyBarChart svg");
  const lineMarkup = lineSvg ? lineSvg.outerHTML
                                .replace(/<rect class="hit"[^>]*><\/rect>/, "")
                                .replace(/<line class="lg-guide"[^>]*><\/line>/, "")
                              : "";
  const barMarkup  = barSvg  ? barSvg.outerHTML.replace(/<rect class="hit"[^>]*><\/rect>/, "") : "";

  const generated = new Date().toLocaleString("en-IN", {
    day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit"
  });

  const kpiRows = state.kpiData.map(function (k) {
    return '<tr>' +
      '<td class="k">' + escapeHtml(k.label) + '</td>' +
      '<td class="v">' + escapeHtml(k.value) + ' ' + escapeHtml(k.unit) + '</td>' +
      '<td class="d">' + escapeHtml(k.sub) + '</td>' +
    '</tr>';
  }).join("");

  let tableRows = "";
  state.months.forEach(function (m, i) {
    const p = state.points[i];
    if (!p || !Number.isFinite(p.spec) || !Number.isFinite(p.avg)) {
      tableRows += '<tr class="miss">' +
        '<td>' + escapeHtml(formatMonthLabel(m)) + '</td>' +
        '<td colspan="6">No data</td></tr>';
      return;
    }
    const lower = limitFromSpec(p.spec, -Math.abs(limit));
    const upper = limitFromSpec(p.spec,  Math.abs(limit));
    const dev = p.avg - p.spec;
    const devPct = p.spec !== 0 ? (dev / p.spec) * 100 : null;
    const ok = limit >= 0 ? dev <= (upper - p.spec) : dev >= (lower - p.spec);

    tableRows += '<tr class="' + (ok ? "" : "out") + '">' +
      '<td class="m">' + escapeHtml(formatMonthLabel(m)) + '</td>' +
      '<td>' + num(p.spec, 3) + '</td>' +
      '<td>' + num(p.avg, 3) + '</td>' +
      '<td>' + signed(dev, 3) + (devPct == null ? "" : " (" + signed(devPct, 2) + "%)") + '</td>' +
      '<td>' + (lower == null ? "—" : num(lower, 3)) + '</td>' +
      '<td>' + (upper == null ? "—" : num(upper, 3)) + '</td>' +
      '<td class="' + (ok ? "ok" : "bad") + '">' + (ok ? "Within limit" : "Out of limit") + '</td>' +
    '</tr>';
  });

  return '<!DOCTYPE html><html><head><meta charset="utf-8">' +
    '<title>JK Tyre · SKU Monthly Running Weight Analysis</title>' +
    '<style>' +
      '@page { size: A4 landscape; margin: 11mm; }' +
      '* { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }' +
      'body { margin:0; font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, Arial, sans-serif;' +
             ' color:#423b5c; font-size:10pt; background:#fcfbff; padding:14mm 10mm; }' +
      '.rpt-head { display:flex; justify-content:space-between; align-items:flex-end;' +
                  ' gap:16px; flex-wrap:wrap; padding-bottom:12px; margin-bottom:16px;' +
                  ' border-bottom:2.5px solid ' + T.brand + '; }' +
      '.rpt-kicker { font-size:8.5pt; font-weight:800; letter-spacing:1.4px; text-transform:uppercase;' +
                    ' color:' + T.brandDeep + '; margin-bottom:5px; }' +
      '.rpt-title { font-size:17pt; font-weight:800; color:#251f3d; letter-spacing:-.3px; line-height:1.2; }' +
      '.rpt-sub { font-size:9.5pt; color:#8e88a3; margin-top:5px; font-weight:600; }' +
      '.rpt-meta { text-align:right; font-size:9pt; color:#8e88a3; font-weight:600; line-height:1.6; }' +
      '.rpt-meta b { color:#4a3d9e; font-weight:800; }' +
      '.info-box { background:#faf8ff; border:1px solid #e8e4f0; border-left:4px solid ' + T.brand + ';' +
                  ' padding:9px 13px; margin:0 0 16px; font-size:9.5pt; line-height:1.65; color:#423b5c; }' +
      '.info-box b { color:#4a3d9e; }' +
      'h2 { font-size:11.5pt; font-weight:800; color:#251f3d; margin:18px 0 8px;' +
           ' padding-bottom:5px; border-bottom:1.5px solid ' + T.brand + '; letter-spacing:-.1px; }' +
      'table { border-collapse:collapse; width:100%; margin:6px 0 4px; background:#ffffff; }' +
      'th { background:#f5f2fc; border:1px solid #e8e4f0; padding:7px 8px; text-align:center;' +
           ' font-size:8.5pt; font-weight:800; color:#8e88a3; text-transform:uppercase; letter-spacing:.5px; }' +
      'td { border:1px solid #f2eff8; padding:6px 8px; text-align:center; font-size:9.5pt; color:#423b5c; }' +
      'td.k { background:#f8f5fd; text-align:left; font-weight:700; color:#251f3d; }' +
      'td.v { font-weight:800; color:#4a3d9e; }' +
      'td.d { text-align:left; color:#8e88a3; }' +
      'td.m { font-weight:800; color:#251f3d; }' +
      'td.ok { color:#357c62; font-weight:800; }' +
      'td.bad { color:#b04d5d; font-weight:800; }' +
      'tr.out td { background:#fdf1f3; }' +
      'tr.miss td { background:#fdfbf8; color:#b5b0c4; font-style:italic; }' +
      '.chart-block { background:#ffffff; border:1px solid #e8e4f0; border-radius:8px; padding:8px; margin:6px 0 2px;' +
                     ' page-break-inside:avoid; }' +
      '.chart-block svg { width:100% !important; height:auto !important; display:block; }' +
      '.legend { display:flex; gap:16px; flex-wrap:wrap; font-size:9pt; font-weight:700;' +
                ' color:#423b5c; padding:2px 4px 6px; }' +
      '.legend span { display:inline-flex; align-items:center; gap:6px; }' +
      '.legend i { display:inline-block; width:16px; height:3px; border-radius:2px; }' +
      '.legend i.dot { width:10px; height:10px; border-radius:50%; }' +
      '.legend i.band { height:9px; border-radius:3px; }' +
      '.note { font-size:8.5pt; color:#b5b0c4; margin-top:10px; line-height:1.6; }' +
      '.rpt-foot { margin-top:18px; padding-top:8px; border-top:1px solid #e8e4f0;' +
                  ' font-size:8pt; color:#b5b0c4; text-align:center; font-weight:600; }' +
      '@media print { h2 { page-break-after: avoid; } .chart-block { page-break-inside: avoid; } }' +
    '</style></head><body>' +

    '<div class="rpt-head">' +
      '<div>' +
        '<div class="rpt-kicker">JK Tyre · Report</div>' +
        '<div class="rpt-title">SKU Monthly Running Weight Analysis</div>' +
        '<div class="rpt-sub">' + escapeHtml(state.sku || "—") +
          ' · Tolerance: ' + escapeHtml(limitLabel) + '</div>' +
      '</div>' +
      '<div class="rpt-meta">Generated<br><b>' + escapeHtml(generated) + '</b></div>' +
    '</div>' +

    '<div class="info-box">' +
      '<b>Months covered:</b> ' + state.points.filter(Boolean).length + ' of ' + state.months.length +
      ' &nbsp;&nbsp;|&nbsp;&nbsp; <b>Weight tolerance:</b> ' + escapeHtml(limitLabel) +
      ' &nbsp;&nbsp;|&nbsp;&nbsp; <b>SKU / Size:</b> ' + escapeHtml(state.sku || "—") +
    '</div>' +

    '<h2>1. Key Performance Indicators</h2>' +
    '<table><thead><tr><th style="width:26%;">Metric</th><th style="width:24%;">Value</th>' +
    '<th>Detail</th></tr></thead><tbody>' + kpiRows + '</tbody></table>' +

    (lineMarkup
      ? '<h2>2. Monthly Trend · Spec vs Running Weight</h2>' +
        '<div class="legend">' +
          '<span><i class="dot" style="background:' + T.chartAvg + '"></i>Avg Running Weight</span>' +
          '<span><i class="dot" style="background:' + T.chartSpec + '"></i>Spec</span>' +
          '<span><i class="band" style="background:rgba(109,93,211,.14);border:1px solid rgba(109,93,211,.4)"></i>' +
          '±' + Math.abs(limit) + '% Tolerance</span>' +
        '</div>' +
        '<div class="chart-block">' + lineMarkup + '</div>'
      : "") +

    (barMarkup
      ? '<h2>3. Monthly Average vs Full-Year Average</h2>' +
        '<div class="legend">' +
          '<span><i class="dot" style="background:rgba(78,173,140,.85)"></i>Within limit</span>' +
          '<span><i class="dot" style="background:rgba(229,115,130,.85)"></i>Out of limit</span>' +
          '<span><i class="dot" style="background:' + T.chartSpec + '"></i>Full-Year Average</span>' +
        '</div>' +
        '<div class="chart-block">' + barMarkup + '</div>'
      : "") +

    '<h2>4. Month-wise Detail</h2>' +
    '<table><thead><tr>' +
      '<th>Month</th>' +
      '<th>Spec (kg)</th>' +
      '<th>Avg Running Weight (kg)</th>' +
      '<th>Deviation</th>' +
      '<th>Lower (' + escapeHtml(limitLabel) + ')</th>' +
      '<th>Upper (' + escapeHtml(limitLabel) + ')</th>' +
      '<th>Status</th>' +
    '</tr></thead><tbody>' + tableRows + '</tbody></table>' +

    '<div class="note">Supplied Spec, Actual, bucket counts, Total tyres and % adher. values are ' +
      'displayed exactly as received — no recalculation is performed. Missing months are shown as ' +
      '"No data" and are excluded from all averages.</div>' +

    '<div class="rpt-foot">JK Tyre · SKU Monthly Running Weight Analysis · ' +
      'Supplied data is displayed as-is without recalculation.</div>' +

    '</body></html>';
}

function exportPdf() {
  if (!state.months.length) {
    alert("Please upload data before exporting.");
    return;
  }

  const html = buildPrintDoc();

  const iframe = document.createElement("iframe");
  iframe.setAttribute("aria-hidden", "true");
  iframe.style.cssText = "position:fixed;right:0;bottom:0;width:0;height:0;border:0;";
  document.body.appendChild(iframe);

  const doc = iframe.contentWindow.document;
  doc.open();
  doc.write(html);
  doc.close();

  setTimeout(function () {
    try {
      iframe.contentWindow.focus();
      iframe.contentWindow.print();
    } catch (err) {
      console.error("PDF export failed:", err);
      alert("PDF export failed: " + (err && err.message ? err.message : err));
    }
    setTimeout(function () {
      if (iframe.parentNode) iframe.parentNode.removeChild(iframe);
    }, 2000);
  }, 400);
}

/* =========================================================
   DOWNLOAD HELPER
========================================================= */
function triggerDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function () { URL.revokeObjectURL(url); }, 500);
}

/* =========================================================
   INIT
========================================================= */
document.addEventListener("DOMContentLoaded", function () {

  /* Header — today's date inside the meta chip */
  const chip = document.getElementById("todayChip");
  if (chip) {
    const valueEl = chip.querySelector("strong");
    if (valueEl) {
      valueEl.textContent = new Date().toLocaleDateString("en-IN", {
        day: "2-digit", month: "short", year: "numeric"
      });
    }
  }

  buildToleranceControl();

  const form = document.getElementById("uploadForm");
  const fileInput = document.getElementById("file");
  const status = document.getElementById("status");
  const dropZone = document.getElementById("dropZone");
  const fileName = document.getElementById("fileName");
  const uploadBtn = document.getElementById("uploadBtn");
  const emptyState = document.getElementById("emptyState");
  const analysisBody = document.getElementById("analysisBody");
  const exportGroup = document.getElementById("exportGroup");
  const backTop = document.getElementById("backTop");

  function showFileName() {
    if (!fileName || !fileInput) return;
    if (fileInput.files && fileInput.files.length) {
      const f = fileInput.files[0];
      fileName.textContent = f.name + "  ·  " + (f.size / 1024).toFixed(1) + " KB";
      fileName.classList.add("show");
    } else {
      fileName.classList.remove("show");
    }
  }
  if (fileInput) fileInput.addEventListener("change", showFileName);

  if (dropZone && fileInput) {
    ["dragenter", "dragover"].forEach(function (ev) {
      dropZone.addEventListener(ev, function (e) {
        e.preventDefault(); e.stopPropagation();
        dropZone.classList.add("dragover");
      });
    });
    ["dragleave", "drop"].forEach(function (ev) {
      dropZone.addEventListener(ev, function (e) {
        e.preventDefault(); e.stopPropagation();
        dropZone.classList.remove("dragover");
      });
    });
    dropZone.addEventListener("drop", function (e) {
      const files = e.dataTransfer && e.dataTransfer.files;
      if (files && files.length) {
        fileInput.files = files;
        showFileName();
      }
    });
    dropZone.addEventListener("click", function (e) {
      if (e.target.closest("#uploadBtn")) return;
      fileInput.click();
    });
  }

  const skuSel = document.getElementById("skuSelect");
  if (skuSel) skuSel.addEventListener("change", renderSkuAnalysis);

  const csvBtn = document.getElementById("exportCsvBtn");
  const wordBtn = document.getElementById("exportWordBtn");
  const pdfBtn = document.getElementById("exportPdfBtn");

  if (csvBtn) csvBtn.addEventListener("click", function () {
    if (state.busy) return;
    exportCsv();
  });

  if (wordBtn) wordBtn.addEventListener("click", async function () {
    if (state.busy) return;
    setBusy(true, "word");
    try { await exportWord(); }
    catch (err) { console.error(err); alert("Word export failed: " + (err && err.message ? err.message : err)); }
    finally { setTimeout(function () { setBusy(false); }, 400); }
  });

  if (pdfBtn) pdfBtn.addEventListener("click", function () {
    if (state.busy) return;
    setBusy(true, "pdf");
    try { exportPdf(); }
    finally { setTimeout(function () { setBusy(false); }, 900); }
  });

  /* Back to top */
  if (backTop) {
    window.addEventListener("scroll", function () {
      if (window.scrollY > 400) backTop.classList.add("show");
      else backTop.classList.remove("show");
    }, { passive: true });
    backTop.addEventListener("click", function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }

  if (!form) return;

  form.addEventListener("submit", async function (e) {
    e.preventDefault();

    if (!fileInput.files.length) {
      status.textContent = "Please select an Excel file.";
      status.className = "error";
      return;
    }

    status.className = "loading";
    status.innerHTML = '<span class="spinner"></span> Processing Excel…';

    if (uploadBtn) {
      uploadBtn.disabled = true;
      uploadBtn.textContent = "Processing…";
    }

    try {
      const fd = new FormData();
      fd.append("file", fileInput.files[0]);

      const res = await fetch("/upload", { method: "POST", body: fd });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || data.error || "Failed to process Excel.");
      }

      dashboard = data;

      populateFilters(data);

      if (emptyState) emptyState.classList.add("hidden");
      if (analysisBody) analysisBody.classList.remove("hidden");
      if (exportGroup) exportGroup.classList.remove("hidden");

      requestAnimationFrame(function () { renderSkuAnalysis(); });

      status.textContent = data.message || "Excel processed successfully.";
      status.className = "success";

    } catch (err) {
      console.error(err);
      status.textContent = err.message;
      status.className = "error";
    } finally {
      if (uploadBtn) {
        uploadBtn.disabled = false;
        uploadBtn.textContent = "Upload & Analyze";
      }
    }
  });

});
</script>

