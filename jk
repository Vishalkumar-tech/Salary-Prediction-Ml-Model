<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JK Tyre · SKU Monthly Running Weight Analysis</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
/* =====================================================
   DESIGN TOKENS
===================================================== */
:root{
  /* Brand */
  --jk-red:        #e30613;
  --jk-red-light:  #ff4438;
  --jk-red-deep:   #b30510;
  --jk-red-glow:   rgba(227, 6, 19, .35);
  --jk-red-tint:   rgba(227, 6, 19, .08);

  /* Neutrals */
  --ink:           #0b1220;
  --ink-2:         #1e293b;
  --slate:         #475569;
  --muted:         #64748b;
  --faint:         #94a3b8;

  /* Surfaces */
  --surface:       #ffffff;
  --surface-2:     #fbfdff;
  --surface-3:     #f5f8fc;

  /* Lines */
  --line:          #e5eaf2;
  --line-2:        #eef2f7;
  --line-strong:   #cbd5e1;

  /* Background */
  --bg:            #eef2f7;

  /* Semantic */
  --ok:            #059669;
  --ok-bg:         #ecfdf5;
  --ok-line:       #a7f3d0;

  --bad:           #dc2626;
  --bad-bg:        #fef2f2;
  --bad-line:      #fecaca;

  --warn:          #d97706;
  --warn-bg:       #fffbeb;
  --warn-line:     #fde68a;

  --info:          #2563eb;
  --info-bg:       #eff6ff;
  --info-line:     #bfdbfe;

  /* Radii */
  --radius-xs:     8px;
  --radius-sm:     12px;
  --radius:        16px;
  --radius-lg:     22px;

  /* Shadows */
  --shadow-xs:     0 1px 2px rgba(15,23,42,.04);
  --shadow-sm:     0 2px 6px rgba(15,23,42,.05);
  --shadow:        0 1px 2px rgba(15,23,42,.04), 0 12px 32px -16px rgba(15,23,42,.18);
  --shadow-lg:     0 2px 4px rgba(15,23,42,.05), 0 26px 48px -22px rgba(15,23,42,.28);
  --shadow-red:    0 10px 26px -10px rgba(227,6,19,.55);

  --font:
    'Inter',
    -apple-system,
    BlinkMacSystemFont,
    'Segoe UI',
    Roboto,
    Arial,
    sans-serif;
}

/* =====================================================
   BASE
===================================================== */
*,*::before,*::after{box-sizing:border-box;}

html{
  scroll-behavior:smooth;
  overflow-x:hidden;
  max-width:100%;
  -webkit-text-size-adjust:100%;
}

body{
  margin:0;
  font-family:var(--font);
  font-size:14px;
  color:var(--ink-2);
  background:
    radial-gradient(1400px 720px at 100% -18%, #dbe7ff 0%, transparent 58%),
    radial-gradient(1100px 640px at -12% 4%, #ffe1e4 0%, transparent 52%),
    radial-gradient(900px 900px at 50% 120%, #e6f0ff 0%, transparent 60%),
    var(--bg);
  background-attachment:fixed;
  overflow-x:hidden;
  max-width:100%;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  min-height:100vh;
}

img{max-width:100%;display:block;}

::selection{background:rgba(227,6,19,.18);color:var(--ink);}

/* =====================================================
   HEADER — PROFESSIONAL DARK
===================================================== */
.app-header{
  position:relative;
  overflow:hidden;
  isolation:isolate;
  color:#fff;
  background:
    radial-gradient(900px 480px at 84% -40%, rgba(227,6,19,.34) 0%, transparent 62%),
    radial-gradient(720px 400px at 2% 132%, rgba(37,99,235,.20) 0%, transparent 62%),
    linear-gradient(125deg, #060912 0%, #0c1222 38%, #131c33 68%, #1c2745 100%);
  border-bottom:1px solid rgba(255,255,255,.06);
  box-shadow:
    0 1px 0 rgba(255,255,255,.05) inset,
    0 26px 60px -40px rgba(0,0,0,.9);
}

/* Top red accent line */
.app-header::before{
  content:"";
  position:absolute;top:0;left:0;right:0;height:3px;z-index:5;
  background:linear-gradient(90deg,
    var(--jk-red) 0%,
    var(--jk-red-light) 26%,
    #ffc2c6 52%,
    rgba(227,6,19,.20) 78%,
    transparent 100%);
}

/* Soft animated red halo */
.app-header::after{
  content:"";
  position:absolute;
  right:-180px;top:-220px;
  width:640px;height:640px;border-radius:50%;
  z-index:0;pointer-events:none;
  background:radial-gradient(circle,
    rgba(227,6,19,.40) 0%,
    rgba(227,6,19,0) 62%);
  animation:headerGlow 9s ease-in-out infinite;
}
@keyframes headerGlow{
  0%,100%{opacity:.82;transform:scale(1);}
  50%{opacity:1;transform:scale(1.09);}
}

/* Fine technical grid */
.header-grid{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.040) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.040) 1px, transparent 1px);
  background-size:48px 48px;
  -webkit-mask-image:radial-gradient(circle at 72% 30%, #000 0%, transparent 72%);
  mask-image:radial-gradient(circle at 72% 30%, #000 0%, transparent 72%);
}

.header-inner{
  position:relative;z-index:3;
  max-width:1600px;margin:0 auto;
  padding:24px 30px;
  display:flex;align-items:center;justify-content:space-between;
  gap:26px;flex-wrap:wrap;
}

/* ---------- Brand block ---------- */
.header-brand{display:flex;align-items:center;gap:20px;min-width:0;}

.logo-badge{
  position:relative;flex:0 0 auto;
  width:68px;height:68px;
  display:grid;place-items:center;
  border-radius:50%;
  background:
    radial-gradient(circle at 50% 38%,
      rgba(255,255,255,.16) 0%,
      rgba(255,255,255,.04) 55%,
      rgba(255,255,255,0) 78%);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.16),
    0 0 0 5px rgba(255,255,255,.045),
    0 14px 32px -12px rgba(0,0,0,.75);
  transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease;
}
.logo-badge:hover{
  transform:translateY(-3px) scale(1.04);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.24),
    0 0 0 7px rgba(227,6,19,.16),
    0 18px 40px -14px rgba(0,0,0,.85);
}
.logo-badge::after{
  content:"";
  position:absolute;inset:-14px;border-radius:50%;
  background:radial-gradient(circle,
    rgba(227,6,19,.48) 0%,
    rgba(227,6,19,0) 66%);
  z-index:-1;pointer-events:none;
  animation:logoHalo 4.5s ease-in-out infinite;
}
@keyframes logoHalo{
  0%,100%{opacity:.7;transform:scale(1);}
  50%{opacity:1;transform:scale(1.13);}
}
.jk-logo{
  width:100%;height:100%;object-fit:contain;
  border-radius:50%;padding:4px;
}
.logo-fallback{
  display:none;font-size:22px;font-weight:900;letter-spacing:1.6px;
  background:linear-gradient(135deg,var(--jk-red-light),#ffd6d8);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  white-space:nowrap;
}
.logo-fallback.show{display:inline-block;}

.brand-divider{
  width:1px;height:52px;flex:0 0 auto;
  background:linear-gradient(180deg,transparent,rgba(255,255,255,.28),transparent);
}

.header-text{min-width:0;}

.header-kicker{
  display:inline-flex;align-items:center;gap:9px;
  margin-bottom:9px;
  font-size:10.5px;font-weight:800;
  letter-spacing:1.5px;text-transform:uppercase;
  color:rgba(255,255,255,.62);
}
.header-kicker::before{
  content:"";width:20px;height:2px;border-radius:2px;flex:0 0 auto;
  background:linear-gradient(90deg,var(--jk-red-light),#ffc2c6);
  box-shadow:0 0 10px rgba(227,6,19,.9);
}

.header-text h1{
  margin:0;
  font-size:23px;font-weight:800;letter-spacing:-.5px;line-height:1.2;
  color:#ffffff;
  text-shadow:0 2px 14px rgba(0,0,0,.35);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.header-text h1 .accent{
  background:linear-gradient(90deg,#ff6a6a 0%,#ffb3b8 55%,#ffd6d8 100%);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}

.header-text p{
  display:flex;align-items:center;gap:10px;
  margin:9px 0 0;
  font-size:12.5px;font-weight:500;letter-spacing:.25px;
  color:rgba(219,214,240,.70);
}

.tag{
  display:inline-flex;align-items:center;gap:6px;
  padding:4px 11px;font-size:10.5px;font-weight:800;
  letter-spacing:.7px;text-transform:uppercase;
  color:#ffd6d8;
  background:rgba(227,6,19,.22);
  border:1px solid rgba(227,6,19,.48);
  border-radius:999px;
  box-shadow:0 0 0 3px rgba(227,6,19,.08);
}
.tag::before{
  content:"";width:6px;height:6px;border-radius:50%;
  background:#ff6a6a;
  box-shadow:0 0 0 3px rgba(255,106,106,.28);
  animation:pulseDot 2.4s ease-in-out infinite;
}

/* ---------- Meta chips ---------- */
.header-meta{display:flex;align-items:center;gap:12px;flex:0 0 auto;}

.meta-chip{
  display:inline-flex;align-items:center;gap:11px;
  padding:10px 17px;
  border-radius:14px;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.14);
  -webkit-backdrop-filter:blur(10px) saturate(150%);
  backdrop-filter:blur(10px) saturate(150%);
  box-shadow:0 1px 0 rgba(255,255,255,.10) inset;
  transition:background .2s ease,border-color .2s ease,transform .2s ease,box-shadow .2s ease;
  white-space:nowrap;
}
.meta-chip:hover{
  background:rgba(255,255,255,.13);
  border-color:rgba(255,255,255,.26);
  transform:translateY(-1px);
  box-shadow:0 8px 22px -14px rgba(0,0,0,.9), 0 1px 0 rgba(255,255,255,.14) inset;
}
.meta-chip > svg{
  width:16px;height:16px;flex:0 0 auto;
  color:rgba(255,200,200,.95);
}
.meta-chip-text{display:flex;flex-direction:column;line-height:1.25;}
.meta-chip-text small{
  font-size:9.5px;font-weight:800;letter-spacing:.95px;
  text-transform:uppercase;color:rgba(206,198,238,.55);
}
.meta-chip-text strong{
  font-size:13px;font-weight:700;letter-spacing:.15px;
  color:#ffffff;
  font-variant-numeric:tabular-nums;
}

.meta-chip.live .live-dot{
  width:8px;height:8px;border-radius:50%;flex:0 0 auto;
  background:#22c55e;
  box-shadow:0 0 0 4px rgba(34,197,94,.20);
  animation:pulseDot 2.4s ease-in-out infinite;
}
@keyframes pulseDot{
  0%,100%{box-shadow:0 0 0 3px rgba(34,197,94,.24);}
  50%{box-shadow:0 0 0 7px rgba(34,197,94,.05);}
}

.header-rule{
  position:relative;z-index:3;height:3px;
  background:linear-gradient(90deg,
    var(--jk-red) 0%,
    var(--jk-red) 28%,
    rgba(227,6,19,.15) 68%,
    transparent 100%);
}

/* =====================================================
   LAYOUT
===================================================== */
.container{
  max-width:1600px;margin:0 auto;
  padding:34px 30px 76px;width:100%;
  overflow-x:clip;
}

/* =====================================================
   CARD
===================================================== */
.card{
  position:relative;
  background:linear-gradient(180deg, #ffffff 0%, #fdfeff 100%);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  padding:28px 30px;
  margin-bottom:26px;
  box-shadow:var(--shadow);
  transition:box-shadow .35s ease, transform .35s ease, border-color .35s ease;
  min-width:0;overflow:hidden;
}
.card::before{
  content:"";
  position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,
    transparent 0%,
    rgba(227,6,19,.14) 26%,
    rgba(37,99,235,.10) 66%,
    transparent 100%);
  opacity:0;
  transition:opacity .35s ease;
}
.card:hover{
  box-shadow:var(--shadow-lg);
  transform:translateY(-2px);
  border-color:#dbe4f0;
}
.card:hover::before{opacity:1;}

.card h2{
  display:flex;align-items:center;gap:12px;
  margin:0 0 10px;
  font-size:18px;font-weight:800;
  letter-spacing:-.25px;
  color:var(--ink);
}
.card h2::before{
  content:"";width:5px;height:20px;border-radius:4px;flex:0 0 auto;
  background:linear-gradient(180deg,var(--jk-red),var(--jk-red-light));
  box-shadow:0 4px 12px -2px var(--jk-red-glow);
}
.card p{
  margin:0 0 18px;
  font-size:13.5px;line-height:1.68;
  color:var(--muted);
}
.card p strong{color:var(--ink-2);font-weight:700;}
.section-note{
  margin:2px 0 0 !important;
  font-size:13px;line-height:1.72;
  color:var(--muted);max-width:1080px;
}

/* =====================================================
   UPLOAD META
===================================================== */
.upload-meta{
  display:flex;flex-wrap:wrap;gap:8px;
  margin:0 0 20px;
}
.upload-meta-item{
  display:inline-flex;align-items:center;gap:7px;
  padding:6px 12px;
  font-size:11.5px;font-weight:600;
  color:var(--slate);
  background:var(--surface-3);
  border:1px solid var(--line);
  border-radius:999px;
}
.upload-meta-item svg{
  width:13px;height:13px;
  color:var(--jk-red);flex:0 0 auto;
}
.upload-meta-item code{
  font-family:ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
  font-size:10.5px;font-weight:700;
  color:var(--jk-red-deep);
  background:rgba(227,6,19,.08);
  padding:1px 6px;border-radius:5px;
  letter-spacing:.3px;
}

/* =====================================================
   UPLOAD AREA
===================================================== */
.upload-area{
  position:relative;
  padding:42px 26px 38px;
  text-align:center;
  background:linear-gradient(180deg, #fbfdff 0%, #f4f8fe 100%);
  border:2px dashed #c8d6e5;
  border-radius:var(--radius-lg);
  cursor:pointer;
  transition:
    border-color .3s ease,
    background .3s ease,
    transform .3s ease,
    box-shadow .3s ease;
  overflow:hidden;
}
.upload-area::before{
  content:"";
  position:absolute;inset:0;
  background:radial-gradient(circle at 50% 30%, rgba(227,6,19,.06), transparent 65%);
  opacity:0;transition:opacity .3s ease;pointer-events:none;
}
.upload-area:hover{
  border-color:var(--jk-red);
  background:linear-gradient(180deg, #fff 0%, #fff6f6 100%);
  box-shadow:
    inset 0 0 0 1px rgba(227,6,19,.06),
    0 14px 34px -20px rgba(227,6,19,.42);
}
.upload-area:hover::before{opacity:1;}
.upload-area.dragover{
  border-color:var(--jk-red);
  border-style:solid;
  background:#fff1f2;
  transform:scale(1.006);
  box-shadow:
    inset 0 0 0 2px rgba(227,6,19,.12),
    0 18px 44px -20px rgba(227,6,19,.58);
}
.upload-icon{
  display:grid;place-items:center;
  width:70px;height:70px;
  margin:0 auto 18px;
  color:var(--jk-red);
  background:linear-gradient(145deg, rgba(227,6,19,.14), rgba(227,6,19,.05));
  border-radius:20px;
  box-shadow:0 10px 24px -12px rgba(227,6,19,.42);
  transition:transform .35s cubic-bezier(.34,1.56,.64,1);
}
.upload-area:hover .upload-icon{
  transform:translateY(-4px) rotate(-4deg) scale(1.06);
}
.upload-icon svg{width:30px;height:30px;}

.upload-title{
  margin:0 0 7px !important;
  font-size:16px !important;font-weight:700;
  color:var(--ink) !important;letter-spacing:-.1px;
}
.upload-hint{
  margin:0 0 22px !important;
  font-size:12.5px !important;
  color:var(--faint) !important;
}

.file-input{
  position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;
}
.file-name{
  display:none;
  margin:0 auto 18px;
  max-width:480px;
  padding:11px 18px;
  font-size:12.5px;font-weight:600;
  color:var(--info);
  background:linear-gradient(180deg, #e0f2fe, #d8ecfd);
  border:1px solid var(--info-line);
  border-radius:12px;
  word-break:break-all;
  box-shadow:0 6px 16px -8px rgba(37,99,235,.30);
  align-items:center;
  gap:10px;
}
.file-name.show{display:inline-flex;}
.file-name::before{
  content:"";width:8px;height:8px;border-radius:50%;
  background:var(--ok);flex:0 0 auto;
  box-shadow:0 0 0 3px rgba(5,150,105,.18);
}

/* =====================================================
   BUTTONS
===================================================== */
button{
  font-family:inherit;
  font-size:14px;font-weight:700;
  letter-spacing:.25px;
  color:#fff;
  background:linear-gradient(135deg, var(--jk-red) 0%, var(--jk-red-light) 55%, #ff5a4e 100%);
  background-size:150% 150%;
  border:none;border-radius:var(--radius-sm);
  padding:13px 32px;cursor:pointer;
  box-shadow:var(--shadow-red);
  transition:transform .18s ease, box-shadow .25s ease, background-position .5s ease;
}
button:hover:not(:disabled){
  background-position:100% 50%;
  transform:translateY(-2px);
  box-shadow:0 14px 34px -10px rgba(227,6,19,.70);
}
button:active:not(:disabled){transform:translateY(0);}
button:focus-visible{
  outline:none;
  box-shadow:0 14px 34px -10px rgba(227,6,19,.70), 0 0 0 4px rgba(227,6,19,.20);
}
button:disabled{opacity:.6;cursor:not-allowed;transform:none;box-shadow:none;}

/* =====================================================
   STATUS
===================================================== */
#status{display:none;margin-top:18px;font-size:13.5px;font-weight:600;}
#status.success,#status.error,#status.loading{
  display:flex;align-items:center;gap:11px;
  padding:13px 18px;border-radius:var(--radius-sm);
  line-height:1.5;
  animation:slideDown .35s ease;
}
@keyframes slideDown{
  from{opacity:0;transform:translateY(-6px);}
  to{opacity:1;transform:translateY(0);}
}
#status.success{
  color:#047857;
  background:var(--ok-bg);
  border:1px solid var(--ok-line);
  box-shadow:0 6px 20px -12px rgba(5,150,105,.40);
}
#status.error{
  color:#b91c1c;
  background:var(--bad-bg);
  border:1px solid var(--bad-line);
  box-shadow:0 6px 20px -12px rgba(220,38,38,.40);
}
#status.loading{
  color:#1d4ed8;
  background:var(--info-bg);
  border:1px solid var(--info-line);
  box-shadow:0 6px 20px -12px rgba(37,99,235,.40);
}

.spinner{
  flex:0 0 auto;width:15px;height:15px;
  border:2.5px solid currentColor;border-top-color:transparent;
  border-radius:50%;animation:spin .7s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}

/* =====================================================
   FILTER GRID
===================================================== */
.filter-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr auto;
  gap:16px;
  align-items:end;
  margin:20px 0 24px;
  padding:18px;
  background:linear-gradient(180deg, #fbfdff 0%, #f7fafd 100%);
  border:1px solid var(--line-2);
  border-radius:var(--radius);
}
.filter-item label{
  display:flex;align-items:center;gap:7px;
  margin-bottom:8px;
  font-size:10.5px;font-weight:800;
  letter-spacing:.8px;text-transform:uppercase;
  color:var(--muted);
}
.filter-item label svg{
  width:12px;height:12px;color:var(--jk-red);
}
.filter-item select{
  width:100%;
  padding:12px 36px 12px 14px;
  font-family:inherit;font-size:13.5px;font-weight:600;
  color:var(--ink);
  background-color:#fff;
  background-image:
    url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
  background-repeat:no-repeat;
  background-position:right 12px center;
  background-size:15px;
  border:1px solid var(--line);
  border-radius:var(--radius-sm);
  appearance:none;-webkit-appearance:none;
  box-shadow:0 1px 2px rgba(15,23,42,.03);
  transition:border-color .18s ease, box-shadow .18s ease;
}
.filter-item select:hover{border-color:var(--line-strong);}
.filter-item select:focus{
  outline:none;
  border-color:var(--jk-red);
  box-shadow:0 0 0 4px rgba(227,6,19,.12);
}
.filter-button button{
  width:100%;
  padding:13px 28px;
}

/* =====================================================
   SKU SELECTED BAR
===================================================== */
.sku-bar{
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;flex-wrap:wrap;
  margin:6px 0 12px;
  padding:16px 22px;
  font-size:15px;font-weight:800;letter-spacing:-.1px;
  color:var(--ink);
  background:linear-gradient(90deg,
    rgba(227,6,19,.09) 0%,
    rgba(227,6,19,.02) 55%,
    rgba(227,6,19,0) 100%);
  border-left:4px solid var(--jk-red);
  border-radius:var(--radius-sm);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.8);
}
.sku-bar .meta{
  font-size:12px;font-weight:600;color:var(--muted);
  display:inline-flex;align-items:center;gap:8px;
}
.sku-bar .meta::before{
  content:"";width:6px;height:6px;border-radius:50%;
  background:var(--jk-red);opacity:.6;
}

/* =====================================================
   MISSING INFO
===================================================== */
.missing-info{
  display:flex;gap:10px;align-items:flex-start;
  margin:12px 0 18px;
  padding:13px 18px;
  font-size:12.5px;line-height:1.65;
  color:#92400e;
  background:linear-gradient(90deg, #fffbeb, #fefce8);
  border-left:4px solid var(--warn);
  border-radius:var(--radius-sm);
  box-shadow:0 6px 18px -12px rgba(180,83,9,.35);
}
.missing-info svg{width:16px;height:16px;flex:0 0 auto;margin-top:1px;}
.missing-info strong{color:#7a4b0f;font-weight:800;}

/* =====================================================
   KPI STRIP
===================================================== */
.kpi-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:16px;
  margin:22px 0 24px;
}
.kpi{
  position:relative;
  padding:20px 20px 18px;
  background:#ffffff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}
.kpi::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg, var(--jk-red), var(--jk-red-light));
  opacity:.85;
}
.kpi.is-ok::before{background:linear-gradient(90deg, #6ee7b7, var(--ok));}
.kpi.is-bad::before{background:linear-gradient(90deg, #fca5a5, var(--bad));}
.kpi.is-info::before{background:linear-gradient(90deg, #93c5fd, var(--info));}
.kpi.is-neutral::before{background:linear-gradient(90deg, #cbd5e1, #94a3b8);}

.kpi:hover{
  transform:translateY(-3px);
  border-color:#dbe4f0;
  box-shadow:0 18px 34px -24px rgba(15,23,42,.4);
}

.kpi-top{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:10px;margin-bottom:12px;
}
.kpi-label{
  font-size:10.5px;font-weight:800;letter-spacing:.8px;
  text-transform:uppercase;color:var(--muted);
  line-height:1.3;
}
.kpi-icon{
  width:30px;height:30px;flex:0 0 auto;
  display:grid;place-items:center;
  border-radius:9px;
  color:var(--jk-red);
  background:rgba(227,6,19,.09);
}
.kpi.is-ok .kpi-icon{color:var(--ok);background:rgba(5,150,105,.11);}
.kpi.is-bad .kpi-icon{color:var(--bad);background:rgba(220,38,38,.11);}
.kpi.is-info .kpi-icon{color:var(--info);background:rgba(37,99,235,.11);}
.kpi.is-neutral .kpi-icon{color:var(--muted);background:rgba(100,116,139,.11);}
.kpi-icon svg{width:15px;height:15px;}

.kpi-value{
  font-size:25px;font-weight:800;letter-spacing:-.7px;
  color:var(--ink);line-height:1.1;
  display:flex;align-items:baseline;gap:5px;
  font-variant-numeric:tabular-nums;
}
.kpi-value .unit{
  font-size:12px;font-weight:700;color:var(--muted);letter-spacing:0;
}
.kpi-sub{
  margin-top:9px;font-size:11.5px;font-weight:600;
  color:var(--faint);
}

/* =====================================================
   CHART
===================================================== */
.chart-wrapper{
  position:relative;
  min-width:0;
  height:460px;
  padding:16px 18px 12px;
  background:linear-gradient(180deg, #ffffff 0%, #fdfdff 100%);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
}

/* =====================================================
   SCROLLBARS
===================================================== */
.table-wrapper{
  scrollbar-width:thin;
  scrollbar-color:#cbd5e1 #f1f5f9;
}
.table-wrapper::-webkit-scrollbar{height:10px;width:10px;}
.table-wrapper::-webkit-scrollbar-track{background:#f1f5f9;border-radius:8px;}
.table-wrapper::-webkit-scrollbar-thumb{
  background:#cbd5e1;border-radius:8px;border:2px solid #f1f5f9;
}
.table-wrapper::-webkit-scrollbar-thumb:hover{background:#94a3b8;}

/* =====================================================
   TABLE
===================================================== */
.table-wrapper{
  width:100%;
  overflow-x:auto;
  overflow-y:hidden;
  border:1px solid var(--line);
  border-radius:var(--radius);
  background:#fff;
  min-width:0;
  margin-top:8px;
  box-shadow:0 2px 8px -4px rgba(15,23,42,.06);
}
table{
