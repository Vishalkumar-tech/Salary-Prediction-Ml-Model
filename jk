/* =========================================================
   TABLE
========================================================= */
function renderTable(selected, points) {
  const tbody = document.getElementById("skuMonthTable");
  if (!tbody) return;

  const tol = getTolerance();
  const tolLabel = toleranceLabel();
  const thLower = document.getElementById("thLower");
  const thUpper = document.getElementById("thUpper");
  if (thLower) thLower.textContent = "Lower (" + tolLabel + ")";
  if (thUpper) thUpper.textContent = "Upper (" + tolLabel + ")";

  tbody.innerHTML = "";

  if (!selected.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="empty-cell">No months selected.</td></tr>';
    return;
  }

  selected.forEach((m, i) => {
    const r = points[i];

    if (!r) {
      tbody.insertAdjacentHTML("beforeend",
        '<tr class="missing-row">' +
          '<td>' + escapeHtml(formatMonthLabel(m)) + '</td>' +
          '<td colspan="6">No data</td>' +
        '</tr>');
      return;
    }

    const spec = r.spec == null ? null : Number(r.spec);
    const run = r.average_running_weight == null ? null : Number(r.average_running_weight);
    const { lo, hi } = boundsForRow(r);

    let dev = null, devPct = null;
    if (Number.isFinite(run) && Number.isFinite(spec) && spec !== 0) {
      dev = run - spec;
      devPct = (dev / spec) * 100;
    }

    const ok = isWithin(r);

    const badge = ok === null
      ? '<span style="color:var(--faint);font-weight:700;">—</span>'
      : ok
        ? '<span class="badge ok">Within ' + escapeHtml(tolLabel) + '</span>'
        : '<span class="badge bad">Out of ' + escapeHtml(tolLabel) + '</span>';

    tbody.insertAdjacentHTML("beforeend",
      '<tr class="' + (ok === false ? "row-out" : "") + '">' +
        '<td>' + escapeHtml(formatMonthLabel(m)) + '</td>' +
        '<td>' + (spec == null ? "—" : n(spec, 3)) + '</td>' +
        '<td>' + (run == null ? "—" : n(run, 3)) + '</td>' +
        '<td>' + (dev == null ? "—" :
          signed(dev, 3) + (devPct == null ? "" :
            ' <span style="color:var(--faint);font-weight:600;">(' + signed(devPct, 2) + '%)</span>')) + '</td>' +
        '<td>' + (lo == null || !Number.isFinite(lo) ? "—" : n(lo, 3)) + '</td>' +
        '<td>' + (hi == null || !Number.isFinite(hi) ? "—" : n(hi, 3)) + '</td>' +
        '<td>' + badge + '</td>' +
      '</tr>');
  });
}

/* =========================================================
   MASTER RENDER
========================================================= */
function renderSkuAnalysis() {
  if (!dashboardData) return;

  const skuEl = document.getElementById("skuSelect");
  const fromEl = document.getElementById("fromMonth");
  const toEl = document.getElementById("toMonth");
  if (!skuEl || !fromEl || !toEl) return;

  const sku = skuEl.value;
  const from = fromEl.value;
  const to = toEl.value;

  const allMonths =
    dashboardData.continuous_months ||
    dashboardData.month_values ||
    (dashboardData.meta && dashboardData.meta.months) ||
    [];

  const monthly = dashboardData.sku_month_summary || [];
  const rows = monthly.filter(r => String(r.sku || "") === String(sku));

  let start = allMonths.indexOf(from);
  let end = allMonths.indexOf(to);
  if (start < 0) start = 0;
  if (end < 0) end = allMonths.length - 1;
  if (start > end) { const t = start; start = end; end = t; }

  const selected = allMonths.slice(start, end + 1);
  const byMonth = new Map(rows.map(r => [String(r.month), r]));
  const points = selected.map(m => byMonth.get(String(m)) || null);

  state.months = selected;
  state.points = points;
  state.sku = sku;

  /* Selected SKU title */
  const title = document.getElementById("skuSelectedTitle");
  if (title) title.textContent = sku ? "Size / SKU: " + sku : "Select a SKU";

  /* Range meta */
  const rangeMeta = document.getElementById("skuRangeMeta");
  if (rangeMeta) {
    const withData = points.filter(Boolean);
    if (withData.length) {
      const first = formatMonthLabel(withData[0].month);
      const last = formatMonthLabel(withData[withData.length - 1].month);
      rangeMeta.textContent = first + " → " + last + " · " +
        withData.length + " of " + selected.length + " months";
    } else {
      rangeMeta.textContent = "";
    }
  }

  /* Bar chart hint */
  const barHint = document.getElementById("barChartHint");
  if (barHint) {
    barHint.textContent = "Green = within " + toleranceLabel() + " · Red = out of limit";
  }

  /* Missing info */
  const missing = points.map((r, i) => (r ? null : i)).filter(i => i !== null);
  const info = document.getElementById("skuMissingInfo");
  if (info) {
    if (missing.length) {
      info.classList.remove("hidden");
      info.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">' +
        '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
        '<div><strong>Missing months:</strong> ' +
        missing.map(i => formatMonthLabel(selected[i])).map(escapeHtml).join(", ") +
        ' — shown as “No data” and excluded from all averages.</div>';
    } else {
      info.classList.add("hidden");
      info.innerHTML = "";
    }
  }

  renderKpis(selected, points);
  renderLineChart(selected, points);
  renderBarChart(selected, points);
  renderTable(selected, points);
}

