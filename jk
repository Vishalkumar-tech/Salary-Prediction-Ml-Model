\========================================================= \*/



function n(v, d = 2) {

    const x = Number(v);

    return Number.isFinite(x) ? x.toFixed(d) : "0";

}



function escapeHtml(value) {

    return String(value == null ? "" : value)

        .replace(/&/g, "&amp;")

        .replace(/\</g, "&lt;")

        .replace(/>/g, "&gt;")

        .replace(/"/g, "&quot;")

        .replace(/'/g, "&#39;");

}



function formatMonthLabel(value) {



    const m = String(value || "").match(/^(\d{4})-(\d{2})$/);

    if (!m) return value;



    const names = [

        "Jan", "Feb", "Mar", "Apr", "May", "Jun",

        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"

    ];



    return \`${names[Number(m[2]) - 1]}-${m[1].slice(2)}\`;

}





/\* =========================================================

   FILTERS

\========================================================= \*/



function populateFilters(data) {



    const skuSelect = document.getElementById("skuSelect");

    const from = document.getElementById("fromMonth");

    const to = document.getElementById("toMonth");



    if (!skuSelect || !from || !to) return;



    const skus = data.sku_values || data.skus || [];



    const months =

        data.continuous_months ||

        data.month_values ||

        (data.meta && data.meta.months) ||

        [];



    skuSelect.innerHTML = skus.length

        ? skus.map(x => \`\<option value="${escapeHtml(x)}">${escapeHtml(x)}\</option>\`).join("")

        : \`\<option value="">No SKU found\</option>\`;



    const opts = months

        .map(x => \`\<option value="${escapeHtml(x)}">${escapeHtml(x)}\</option>\`)

        .join("");



    from.innerHTML = opts;

    to.innerHTML = opts;



    if (months.length) {

        from.value = months[0];

        to.value = months[months.length - 1];

    }



    if (skus.length) skuSelect.value = skus[0];

}





/\* =========================================================

