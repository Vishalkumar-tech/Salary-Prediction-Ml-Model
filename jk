<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JK Tyre · SKU Monthly Running Weight Analysis</title>

<style>
/* =====================================================
   ============  PREMIUM LAVENDER THEME  ==============
   Refined indigo-violet on warm pearl canvas,
   with soft coral accents and mint success states.
===================================================== */
:root{
  /* Brand — rich indigo-violet */
  --brand-rgb:   109,93,211;
  --brand:       #6d5dd3;
  --brand-dark:  #5346b3;
  --brand-light: #8b7fe0;
  --brand-deep:  #4a3d9e;
  --brand-tint:  #efeafe;

  /* Secondary — soft coral */
  --brand-2:     #f4a4a4;
  --brand-2-rgb: 244,164,164;

  /* Success mint */
  --brand-3:     #4ead8c;

  /* Surfaces — warm pearl */
  --bg-0:        #fcfbff;
  --bg-1:        #f6f4fb;
  --bg-2:        #eeebf6;
  --bg-3:        #e7e3f2;

  --surface:     #ffffff;
  --surface-2:   #fbfaff;
  --surface-3:   #f5f3fb;

  --line:        #e8e4f0;
  --line-2:      #f2eff8;
  --line-strong: #d9d3e8;

  /* Text — deep plum */
  --ink:         #251f3d;
  --ink-2:       #423b5c;
  --body:        #5f5876;
  --muted:       #8e88a3;
  --faint:       #b5b0c4;

  /* Semantic */
  --ok:          #4ead8c;
  --ok-bg:       #eef8f3;
  --ok-line:     #c7e6d7;
  --ok-text:     #357c62;

  --bad:         #e57382;
  --bad-bg:      #fdf1f3;
  --bad-line:    #f5d0d6;
  --bad-text:    #b04d5d;

  --warn:        #d99a4e;
  --warn-bg:     #fcf5e9;
  --warn-line:   #f0dfb9;
  --warn-text:   #9b6b2b;

  --info:        #6d84d3;

  --radius:      22px;
  --radius-sm:   14px;
  --radius-xs:   10px;

  --shadow-xs:   0 1px 2px rgba(37,31,61,.04);
  --shadow-sm:   0 2px 6px rgba(37,31,61,.05), 0 1px 2px rgba(37,31,61,.03);
  --shadow:      0 1px 2px rgba(37,31,61,.04), 0 12px 28px -16px rgba(37,31,61,.14);
  --shadow-lg:   0 1px 2px rgba(37,31,61,.04), 0 24px 48px -22px rgba(37,31,61,.22);
  --shadow-glow: 0 0 0 4px rgba(109,93,211,.10);

  --font: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}

/* =====================================================
   BASE
===================================================== */
*,*::before,*::after{box-sizing:border-box;}

html{
  scroll-behavior:smooth;
  overflow-x:hidden;
  max-width:100%;
  -webkit-text-size-adjust:100%;
}

body{
  margin:0;
  font-family:var(--font);
  font-size:14px;
  color:var(--body);
  background:
    radial-gradient(1200px 640px at 105% -12%, rgba(244,164,164,.14) 0%, transparent 55%),
    radial-gradient(1000px 580px at -8% 4%, rgba(109,93,211,.13) 0%, transparent 55%),
    radial-gradient(900px 820px at 50% 118%, rgba(78,173,140,.09) 0%, transparent 60%),
    linear-gradient(180deg, var(--bg-0) 0%, var(--bg-1) 45%, var(--bg-0) 100%);
  background-attachment:fixed;
  overflow-x:hidden;
  max-width:100%;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  min-height:100vh;
}

img{max-width:100%;display:block;}

::selection{background:rgba(109,93,211,.20);color:var(--ink);}

/* =====================================================
   HEADER  —  PROFESSIONAL DARK INDIGO
===================================================== */
.app-header{
  position:relative;
  overflow:hidden;
  isolation:isolate;
  background:
    radial-gradient(1000px 500px at 84% -40%, rgba(139,127,224,.55) 0%, transparent 62%),
    radial-gradient(820px 440px at 2% 132%, rgba(244,164,164,.20) 0%, transparent 62%),
    linear-gradient(118deg, #221b42 0%, #2b2358 36%, #382d78 72%, #453a95 100%);
  border-bottom:1px solid rgba(109,93,211,.45);
  box-shadow:
    0 1px 0 rgba(255,255,255,.06) inset,
    0 26px 60px -38px rgba(18,14,40,.95);
}

/* Top accent line */
.app-header::before{
  content:"";
  position:absolute;top:0;left:0;right:0;height:3px;z-index:5;
  background:linear-gradient(90deg,
    transparent 0%,
    #8b7fe0 16%,
    #b3a6f5 40%,
    #f4a4a4 72%,
    transparent 100%);
}

/* Soft animated halo */
.header-glow{
  position:absolute;
  right:-170px;top:-250px;
  width:640px;height:640px;border-radius:50%;
  z-index:0;pointer-events:none;
  background:radial-gradient(circle, rgba(163,150,255,.36) 0%, rgba(163,150,255,0) 64%);
  animation:headerGlow 12s ease-in-out infinite;
}
@keyframes headerGlow{
  0%,100%{opacity:.65;transform:scale(1);}
  50%{opacity:1;transform:scale(1.10);}
}

/* Fine technical grid */
.header-grid{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px);
  background-size:58px 58px;
  -webkit-mask-image:radial-gradient(circle at 74% 30%, #000 0%, transparent 72%);
  mask-image:radial-gradient(circle at 74% 30%, #000 0%, transparent 72%);
}

.header-inner{
  position:relative;z-index:3;
  max-width:1560px;margin:0 auto;
  padding:26px 32px;
  display:flex;align-items:center;justify-content:space-between;
  gap:28px;flex-wrap:wrap;
}

/* ---------- Brand block ---------- */
.header-brand{display:flex;align-items:center;gap:20px;min-width:0;}

.logo-badge{
  position:relative;flex:0 0 auto;
  width:66px;height:66px;
  display:grid;place-items:center;
  border-radius:20px;
  background:linear-gradient(150deg, #ffffff 0%, #f3efff 100%);
  border:1px solid rgba(255,255,255,.55);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.22) inset,
    0 14px 30px -14px rgba(0,0,0,.70),
    0 0 0 6px rgba(255,255,255,.055);
  transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease;
}
.logo-badge:hover{
  transform:translateY(-3px) scale(1.04);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.30) inset,
    0 18px 36px -14px rgba(0,0,0,.80),
    0 0 0 8px rgba(255,255,255,.09);
}
.jk-logo{
  width:100%;height:100%;object-fit:contain;
  border-radius:18px;padding:5px;
}
.logo-fallback{
  display:none;font-size:23px;font-weight:900;letter-spacing:1.4px;
  background:linear-gradient(135deg,var(--brand-deep),var(--brand-2));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  white-space:nowrap;
}
.logo-fallback.show{display:inline-block;}

.header-text{min-width:0;}

.header-kicker{
  display:inline-flex;align-items:center;gap:9px;
  margin-bottom:9px;
  font-size:10.5px;font-weight:800;
  letter-spacing:1.5px;text-transform:uppercase;
  color:rgba(214,206,255,.80);
}
.header-kicker::before{
  content:"";width:20px;height:2px;border-radius:2px;flex:0 0 auto;
  background:linear-gradient(90deg,#8b7fe0,#f4a4a4);
  box-shadow:0 0 10px rgba(163,150,255,.7);
}

.header-text h1{
  margin:0;
  font-size:23px;font-weight:800;letter-spacing:-.5px;line-height:1.2;
  color:#ffffff;
  text-shadow:0 2px 14px rgba(0,0,0,.35);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.header-text h1 .accent{
  background:linear-gradient(90deg,#c9bfff 0%,#e9b6d6 52%,#f4a4a4 100%);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}

.header-text p{
  margin:9px 0 0;
  font-size:12.5px;font-weight:500;letter-spacing:.25px;
  color:rgba(219,214,240,.66);
}

/* ---------- Meta chips ---------- */
.header-meta{display:flex;align-items:center;gap:12px;flex:0 0 auto;}

.meta-chip{
  display:inline-flex;align-items:center;gap:11px;
  padding:10px 17px;
  border-radius:14px;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.14);
  -webkit-backdrop-filter:blur(10px) saturate(150%);
  backdrop-filter:blur(10px) saturate(150%);
  box-shadow:0 1px 0 rgba(255,255,255,.10) inset;
  transition:background .2s ease,border-color .2s ease,transform .2s ease,box-shadow .2s ease;
  white-space:nowrap;
}
.meta-chip:hover{
  background:rgba(255,255,255,.13);
  border-color:rgba(255,255,255,.26);
  transform:translateY(-1px);
  box-shadow:0 8px 22px -14px rgba(0,0,0,.9), 0 1px 0 rgba(255,255,255,.14) inset;
}
.meta-chip > svg{
  width:16px;height:16px;flex:0 0 auto;
  color:rgba(200,190,255,.92);
}

.meta-chip-text{display:flex;flex-direction:column;line-height:1.25;}
.meta-chip-text small{
  font-size:9.5px;font-weight:800;letter-spacing:.95px;
  text-transform:uppercase;color:rgba(206,198,238,.58);
}
.meta-chip-text strong{
  font-size:13px;font-weight:700;letter-spacing:.15px;
  color:#ffffff;
  font-variant-numeric:tabular-nums;
}

.meta-chip.live .live-dot{
  width:8px;height:8px;border-radius:50%;flex:0 0 auto;
  background:#5fd3a6;
  box-shadow:0 0 0 4px rgba(95,211,166,.18);
  animation:pulse-dot 2.4s ease-in-out infinite;
}
@keyframes pulse-dot{
  0%,100%{box-shadow:0 0 0 3px rgba(95,211,166,.22);}
  50%{box-shadow:0 0 0 7px rgba(95,211,166,.05);}
}

/* Bottom hairline */
.header-rule{
  position:relative;z-index:3;height:1px;
  background:linear-gradient(90deg,
    transparent 0%,
    rgba(163,150,255,.45) 26%,
    rgba(244,164,164,.30) 62%,
    transparent 100%);
}

/* =====================================================
   LAYOUT
===================================================== */
.container{
  max-width:1560px;margin:0 auto;
  padding:36px 32px 90px;width:100%;overflow-x:clip;
}

/* =====================================================
   CARD
===================================================== */
.card{
  position:relative;
  background:#ffffff;
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:30px 32px;margin-bottom:24px;
  box-shadow:var(--shadow);
  transition:box-shadow .35s ease,border-color .35s ease;
  min-width:0;overflow:hidden;
}
.card::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg, transparent 0%, rgba(109,93,211,.32) 30%, rgba(244,164,164,.32) 70%, transparent 100%);
  opacity:0;transition:opacity .35s ease;
}
.card:hover{
  box-shadow:var(--shadow-lg);
  border-color:rgba(109,93,211,.20);
}
.card:hover::before{opacity:1;}

.card-head{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:20px;flex-wrap:wrap;margin-bottom:10px;
}
.card-title-group{min-width:0;flex:1 1 320px;}
.card h2{
  display:flex;align-items:center;gap:14px;
  margin:0 0 10px;font-size:18px;font-weight:800;
  letter-spacing:-.3px;color:var(--ink);
}
.card h2::before{
  content:"";width:4px;height:22px;border-radius:4px;flex:0 0 auto;
  background:linear-gradient(180deg,var(--brand-light),var(--brand-2));
  box-shadow:0 4px 10px -2px rgba(109,93,211,.5);
}
.card p{margin:0 0 18px;font-size:13.5px;line-height:1.72;color:var(--muted);}
.card p strong{color:var(--brand-deep);font-weight:700;}
.section-note{
  margin:2px 0 0 !important;font-size:13px;line-height:1.75;
  color:var(--muted);max-width:1000px;
}

/* =====================================================
   EXPORT BUTTON GROUP
===================================================== */
.export-group{
  display:flex;gap:6px;flex-wrap:wrap;align-items:center;
  padding:5px;border-radius:14px;
  background:var(--surface-3);
  border:1px solid var(--line);
  box-shadow:0 1px 0 rgba(255,255,255,.9) inset;
}

.export-btn{
  display:inline-flex;align-items:center;gap:7px;
  padding:9px 15px !important;
  font-family:inherit;
  font-size:12px !important;font-weight:700 !important;letter-spacing:.3px;
  color:var(--ink-2) !important;
  background:#ffffff !important;
  border:1px solid transparent !important;
  border-radius:10px !important;
  box-shadow:0 1px 2px rgba(37,31,61,.05) !important;
  cursor:pointer;
  transition:all .2s ease !important;
  background-image:none !important;
}
.export-btn:hover:not(:disabled){
  color:#fff !important;
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%) !important;
  border-color:var(--brand) !important;
  transform:translateY(-1px) !important;
  box-shadow:0 8px 18px -8px rgba(109,93,211,.7) !important;
}
.export-btn:active:not(:disabled){transform:translateY(0) !important;}
.export-btn svg{width:14px;height:14px;flex:0 0 auto;}
.export-btn[data-kind="csv"]:hover:not(:disabled){
  background:linear-gradient(135deg,#6d9dd3,#4b7ab0) !important;
  border-color:#6d9dd3 !important;
  box-shadow:0 8px 18px -8px rgba(109,157,211,.7) !important;
}
.export-btn[data-kind="word"]:hover:not(:disabled){
  background:linear-gradient(135deg,#7f8fd3,#5c6cb8) !important;
  border-color:#7f8fd3 !important;
  box-shadow:0 8px 18px -8px rgba(127,143,211,.7) !important;
}
.export-btn[data-kind="pdf"]:hover:not(:disabled){
  background:linear-gradient(135deg,var(--brand-2),#db8790) !important;
  border-color:var(--brand-2) !important;
  box-shadow:0 8px 18px -8px rgba(244,164,164,.75) !important;
}
.export-btn:disabled{opacity:.5;cursor:not-allowed;}

/* =====================================================
   UPLOAD
===================================================== */
.upload-meta{
  display:flex;flex-wrap:wrap;gap:8px;margin:0 0 18px;
}
.upload-meta-item{
  display:inline-flex;align-items:center;gap:7px;
  padding:6px 12px;font-size:11.5px;font-weight:600;
  color:var(--body);
  background:var(--surface-3);
  border:1px solid var(--line);
  border-radius:999px;
}
.upload-meta-item svg{width:13px;height:13px;color:var(--brand);flex:0 0 auto;}
.upload-meta-item code{
  font-family:var(--mono);font-size:10.5px;font-weight:700;
  color:var(--brand-deep);
  background:rgba(109,93,211,.10);
  padding:1px 6px;border-radius:5px;
  letter-spacing:.3px;
}

.upload-area{
  position:relative;padding:44px 26px 40px;text-align:center;
  background:
    linear-gradient(180deg, #fdfbff 0%, #faf6fc 100%);
  border:1.5px dashed rgba(109,93,211,.35);
  border-radius:var(--radius);cursor:pointer;
  transition:all .3s ease;
  overflow:hidden;
}
.upload-area::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(circle at 50% 30%, rgba(109,93,211,.10), transparent 65%);
  opacity:0;transition:opacity .3s ease;pointer-events:none;
}
.upload-area:hover{
  border-color:var(--brand);
  background:linear-gradient(180deg, #fffdff 0%, #fbf6fe 100%);
  box-shadow:0 12px 30px -20px rgba(109,93,211,.55);
}
.upload-area:hover::before{opacity:1;}
.upload-area.dragover{
  border-color:var(--brand);
  border-style:solid;
  background:rgba(109,93,211,.06);
  transform:scale(1.006);
  box-shadow:
    0 0 0 3px rgba(109,93,211,.12) inset,
    0 16px 40px -22px rgba(109,93,211,.7);
}
.upload-icon{
  display:grid;place-items:center;width:72px;height:72px;
  margin:0 auto 20px;
  color:var(--brand);
  background:linear-gradient(145deg, rgba(109,93,211,.16), rgba(244,164,164,.10));
  border-radius:22px;
  box-shadow:
    0 8px 22px -12px rgba(109,93,211,.6),
    0 0 0 1px rgba(255,255,255,.9) inset;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1);
}
.upload-area:hover .upload-icon{
  transform:translateY(-4px) rotate(-4deg) scale(1.06);
  box-shadow:
    0 14px 30px -14px rgba(109,93,211,.75),
    0 0 0 1px rgba(255,255,255,.9) inset;
}
.upload-icon svg{width:30px;height:30px;}
.upload-title{margin:0 0 8px !important;font-size:16px !important;font-weight:700;color:var(--ink) !important;letter-spacing:-.1px;}
.upload-hint{margin:0 0 24px !important;font-size:12.5px !important;color:var(--faint) !important;}
.file-input{
  position:absolute;width:1px;height:1px;padding:0;margin:-1px;
  overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;
}
.file-name{
  display:none;margin:0 auto 20px;max-width:480px;
  padding:12px 18px;font-size:12.5px;font-weight:600;
  color:var(--brand-deep);
  background:rgba(109,93,211,.08);
  border:1px solid rgba(109,93,211,.25);
  border-radius:12px;
  word-break:break-all;
  box-shadow:0 4px 12px -8px rgba(109,93,211,.5);
  align-items:center;
  gap:10px;
}
.file-name.show{display:inline-flex;}
.file-name::before{
  content:"";width:8px;height:8px;border-radius:50%;
  background:var(--brand-3);flex:0 0 auto;
  box-shadow:0 0 0 3px rgba(78,173,140,.20);
}

/* =====================================================
   MAIN BUTTON
===================================================== */
button{
  font-family:inherit;font-size:13.5px;font-weight:700;letter-spacing:.35px;
  color:#ffffff;
  background:linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 50%, var(--brand-2) 100%);
  background-size:180% 180%;
  border:none;border-radius:var(--radius-sm);
  padding:14px 34px;cursor:pointer;
  box-shadow:
    0 10px 24px -12px rgba(109,93,211,.75),
    0 1px 0 rgba(255,255,255,.35) inset;
  transition:transform .2s ease, box-shadow .3s ease, background-position .55s ease, opacity .2s ease;
  position:relative;
  text-shadow:0 1px 1px rgba(74,61,158,.25);
}
button:hover:not(:disabled){
  background-position:100% 50%;
  transform:translateY(-2px);
  box-shadow:
    0 16px 34px -14px rgba(109,93,211,.85),
    0 1px 0 rgba(255,255,255,.4) inset;
}
button:active:not(:disabled){transform:translateY(0);}
button:focus-visible{
  outline:none;
  box-shadow:
    0 10px 24px -12px rgba(109,93,211,.75),
    0 0 0 4px rgba(109,93,211,.22);
}
button:disabled{opacity:.55;cursor:not-allowed;transform:none;box-shadow:none;}

/* =====================================================
   STATUS
===================================================== */
#status{display:none;margin-top:18px;font-size:13.5px;font-weight:600;}
#status.success,#status.error,#status.loading{
  display:flex;align-items:center;gap:12px;
  padding:14px 18px;border-radius:var(--radius-sm);line-height:1.5;
  animation:slideDown .35s ease;
}
@keyframes slideDown{
  from{opacity:0;transform:translateY(-6px);}
  to{opacity:1;transform:translateY(0);}
}
#status.success{
  color:var(--ok-text);
  background:var(--ok-bg);
  border:1px solid var(--ok-line);
  box-shadow:0 6px 20px -12px rgba(78,173,140,.5);
}
#status.error{
  color:var(--bad-text);
  background:var(--bad-bg);
  border:1px solid var(--bad-line);
  box-shadow:0 6px 20px -12px rgba(229,115,130,.5);
}
#status.loading{
  color:var(--brand-deep);
  background:rgba(109,93,211,.08);
  border:1px solid rgba(109,93,211,.25);
  box-shadow:0 6px 20px -12px rgba(109,93,211,.5);
}

.spinner{
  flex:0 0 auto;width:16px;height:16px;
  border:2.5px solid currentColor;border-top-color:transparent;
  border-radius:50%;animation:spin .7s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}

/* =====================================================
   CONTROLS
===================================================== */
.controls{
  display:grid;
  grid-template-columns:minmax(0,1.4fr) minmax(0,2fr);
  gap:20px;margin:20px 0 26px;padding:22px;
  background:linear-gradient(180deg, #fdfbff 0%, #faf6fc 100%);
  border:1px solid var(--line);
  border-radius:var(--radius);
}
.field label{
  display:flex;align-items:center;gap:7px;
  margin-bottom:10px;
  font-size:10.5px;font-weight:800;letter-spacing:.8px;
  text-transform:uppercase;color:var(--muted);
}
.field label svg{width:12px;height:12px;color:var(--brand);}
.field select{
  width:100%;padding:13px 40px 13px 15px;
  font-family:inherit;font-size:13.5px;font-weight:600;color:var(--ink);
  background-color:#ffffff;
  background-image:url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236d5dd3' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
  background-repeat:no-repeat;background-position:right 14px center;background-size:15px;
  border:1px solid var(--line-strong);
  border-radius:var(--radius-sm);
  appearance:none;-webkit-appearance:none;
  box-shadow:0 1px 2px rgba(37,31,61,.04);
  transition:border-color .18s ease, box-shadow .18s ease;
}
.field select:hover{border-color:var(--brand-light);}
.field select:focus{
  outline:none;
  border-color:var(--brand);
  box-shadow:0 0 0 4px rgba(109,93,211,.15);
}

/* Segmented tolerance control */
.tolerance-wrap{
  display:flex;flex-wrap:wrap;gap:6px;
}
.tol-btn{
  flex:0 0 auto;
  padding:9px 13px;
  font-family:inherit;
  font-size:12px;font-weight:700;letter-spacing:.2px;
  color:var(--ink-2);
  background:#ffffff;
  border:1px solid var(--line-strong);
  border-radius:10px;
  cursor:pointer;
  transition:all .18s ease;
  min-width:52px;
  text-align:center;
}
.tol-btn:hover{
  border-color:var(--brand-light);
  background:rgba(109,93,211,.05);
  color:var(--brand-deep);
}
.tol-btn.active{
  color:#ffffff;
  background:linear-gradient(135deg,var(--brand),var(--brand-deep));
  border-color:var(--brand);
  box-shadow:0 6px 14px -6px rgba(109,93,211,.7);
  transform:translateY(-1px);
}
.tol-btn:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(109,93,211,.25);}

/* =====================================================
   KPI STRIP
===================================================== */
.kpi-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
  gap:16px;margin-bottom:24px;
}
.kpi{
  position:relative;padding:20px 20px 18px;
  background:#ffffff;
  border:1px solid var(--line);
  border-radius:var(--radius-sm);
  overflow:hidden;
  transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}
.kpi::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg, var(--brand-light), var(--brand-2));
  opacity:.9;
}
.kpi:hover{
  transform:translateY(-3px);
  border-color:rgba(109,93,211,.25);
  box-shadow:0 18px 34px -24px rgba(37,31,61,.4);
}
.kpi.is-ok::before{background:linear-gradient(90deg, #8bd4b3, var(--brand-3));}
.kpi.is-bad::before{background:linear-gradient(90deg, #f0a5b1, var(--bad));}
.kpi.is-neutral::before{background:linear-gradient(90deg, #cbc7d8, #9a94a6);}

.kpi-top{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:10px;margin-bottom:12px;
}
.kpi-label{
  font-size:10.5px;font-weight:800;letter-spacing:.8px;text-transform:uppercase;
  color:var(--muted);line-height:1.3;
}
.kpi-icon{
  width:30px;height:30px;flex:0 0 auto;
  display:grid;place-items:center;
  border-radius:9px;
  color:var(--brand);
  background:rgba(109,93,211,.10);
}
.kpi.is-ok .kpi-icon{color:var(--ok);background:rgba(78,173,140,.12);}
.kpi.is-bad .kpi-icon{color:var(--bad);background:rgba(229,115,130,.12);}
.kpi.is-neutral .kpi-icon{color:var(--muted);background:rgba(142,136,163,.12);}
.kpi-icon svg{width:15px;height:15px;}

.kpi-value{
  font-size:25px;font-weight:800;letter-spacing:-.7px;color:var(--ink);
  line-height:1.1;display:flex;align-items:baseline;gap:5px;
  font-variant-numeric:tabular-nums;
}
.kpi-value .unit{font-size:12px;font-weight:700;color:var(--muted);letter-spacing:0;}
.kpi-sub{margin-top:9px;font-size:11.5px;font-weight:600;color:var(--faint);}

/* =====================================================
   SKU BAR
===================================================== */
.sku-bar{
  display:flex;align-items:center;justify-content:space-between;
  gap:16px;flex-wrap:wrap;margin:6px 0 10px;padding:18px 22px;
  font-size:15px;font-weight:800;letter-spacing:-.1px;color:var(--ink);
  background:linear-gradient(90deg, rgba(109,93,211,.10) 0%, rgba(244,164,164,.05) 55%, transparent 100%);
  border-left:4px solid var(--brand);
  border-radius:var(--radius-sm);
  box-shadow:0 1px 0 rgba(255,255,255,.7) inset;
}
.sku-bar .meta{
  font-size:12px;font-weight:600;color:var(--muted);
  display:inline-flex;align-items:center;gap:8px;
}
.sku-bar .meta::before{
  content:"";width:6px;height:6px;border-radius:50%;
  background:var(--brand);opacity:.6;
}

.missing-info{
  display:flex;gap:10px;align-items:flex-start;
  margin:14px 0 0;padding:14px 18px;
  font-size:12.5px;line-height:1.65;
  color:var(--warn-text);
  background:var(--warn-bg);
  border:1px solid var(--warn-line);
  border-radius:var(--radius-sm);
}
.missing-info svg{width:16px;height:16px;flex:0 0 auto;margin-top:1px;}
.missing-info strong{color:#7a5218;font-weight:800;}

.panel-title{
  display:flex;align-items:center;gap:10px;
  margin:32px 0 16px;
  font-size:11.5px;font-weight:800;letter-spacing:1px;
  text-transform:uppercase;color:var(--muted);
}
.panel-title::before{
  content:"";width:6px;height:6px;border-radius:50%;
  background:var(--brand);
  box-shadow:0 0 0 4px rgba(109,93,211,.14);
}
.panel-title .hint{
  margin-left:auto;
  font-size:10.5px;font-weight:600;letter-spacing:.3px;
  text-transform:none;color:var(--faint);
  display:inline-flex;align-items:center;gap:6px;
}
.panel-title .hint svg{width:12px;height:12px;}

/* =====================================================
   CHARTS
===================================================== */
.chart-wrapper{
  position:relative;min-width:0;
  display:flex;flex-direction:column;
  height:420px;
  padding:16px 18px 10px;
  background:linear-gradient(180deg, #ffffff 0%, #fdfbff 100%);
  border:1px solid var(--line);
  border-radius:var(--radius);
}
.chart-wrapper.tall{height:480px;}

.chart-legend{
  display:flex;gap:22px;flex-wrap:wrap;
  padding:2px 4px 12px;
  font-size:12px;font-weight:700;color:var(--ink-2);
}
.chart-legend .lg{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;}
.chart-legend .lg i{display:inline-block;width:18px;height:3px;border-radius:2px;}
.chart-legend .lg i.band{height:10px;border-radius:3px;}
.chart-legend .lg i.dot{
  width:10px;height:10px;border-radius:50%;
}

.chart-host{
  position:relative;flex:1;min-height:0;min-width:0;
}
.chart-host svg{display:block;}

.chart-empty{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:10px;height:100%;width:100%;
  color:var(--faint);
}
.chart-empty svg{width:38px;height:38px;opacity:.5;}
.chart-empty span{font-size:13px;font-weight:600;}

.chart-tip{
  position:absolute;pointer-events:none;z-index:8;
  min-width:190px;padding:12px 14px;
  background:#ffffff;
  color:var(--ink-2);
  border:1px solid rgba(109,93,211,.25);
  border-radius:13px;font-size:12px;line-height:1.55;
  box-shadow:
    0 18px 36px -14px rgba(37,31,61,.28),
    0 4px 10px -4px rgba(109,93,211,.20);
  opacity:0;transform:translateY(4px);
  transition:opacity .15s ease, transform .15s ease;
}
.chart-tip.show{opacity:1;transform:translateY(0);}
.chart-tip .tt{
  font-weight:800;color:var(--ink);font-size:12.5px;
  margin-bottom:8px;letter-spacing:.2px;
  padding-bottom:7px;border-bottom:1px solid var(--line-2);
}
.chart-tip .tr{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:3px 0;}
.chart-tip .tr > span{display:inline-flex;align-items:center;gap:7px;color:var(--muted);font-weight:600;}
.chart-tip .tr b{color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums;}
.chart-tip .dot{width:8px;height:8px;border-radius:50%;display:inline-block;}

/* =====================================================
   SCROLLBARS
===================================================== */
.table-wrapper{scrollbar-width:thin;scrollbar-color:rgba(109,93,211,.35) #f2eff8;}
.table-wrapper::-webkit-scrollbar{height:10px;width:10px;}
.table-wrapper::-webkit-scrollbar-track{background:#f2eff8;border-radius:8px;}
.table-wrapper::-webkit-scrollbar-thumb{
  background:rgba(109,93,211,.35);border-radius:8px;border:2px solid #f2eff8;
}
.table-wrapper::-webkit-scrollbar-thumb:hover{background:rgba(109,93,211,.6);}

/* =====================================================
   TABLE
===================================================== */
.table-wrapper{
  width:100%;overflow-x:auto;overflow-y:hidden;margin-top:8px;
  border:1px solid var(--line);
  border-radius:var(--radius);
  background:#ffffff;
  min-width:0;
  box-shadow:0 1px 3px rgba(37,31,61,.03);
}
table{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;}
th{
  position:sticky;top:0;z-index:2;padding:15px 14px;
  font-size:10.5px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;
  text-align:center;white-space:nowrap;color:var(--muted);
  background:linear-gradient(180deg, #faf8ff 0%, #f5f3fb 100%);
  border-bottom:1px solid rgba(109,93,211,.16);
}
td{
  padding:13px 14px;text-align:center;white-space:nowrap;
  color:var(--body);font-weight:500;
  border-bottom:1px solid var(--line-2);
  transition:background .15s ease;
  font-variant-numeric:tabular-nums;
}
tbody tr:nth-child(even) td{background:#fcfbff;}
tbody tr:hover td{background:rgba(109,93,211,.05);}
tbody tr:last-child td{border-bottom:none;}
tbody td:first-child{font-weight:700;color:var(--ink);}

tr.row-out td{background:#fdf1f3 !important;}
tr.row-out:hover td{background:#fbe7ec !important;}

.badge{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 12px;border-radius:999px;
  font-size:11px;font-weight:800;letter-spacing:.35px;white-space:nowrap;
}
.badge.ok{
  color:var(--ok-text);
  background:var(--ok-bg);
  border:1px solid var(--ok-line);
}
.badge.bad{
  color:var(--bad-text);
  background:var(--bad-bg);
  border:1px solid var(--bad-line);
}
.badge::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;}

tr.missing-row td{
  background:#fdfbf8 !important;
  color:var(--faint) !important;
  font-style:italic;font-weight:600;
}
tr.missing-row:hover td{background:#f9f5f0 !important;}

.empty-cell{
  padding:52px 16px !important;font-style:italic;
  color:var(--faint) !important;background:transparent !important;
}

/* =====================================================
   EMPTY STATE
===================================================== */
.empty-state{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:14px;padding:80px 20px;text-align:center;
  position:relative;
}
.empty-state::before{
  content:"";position:absolute;
  width:380px;height:380px;border-radius:50%;
  background:radial-gradient(circle, rgba(109,93,211,.09), transparent 65%);
  pointer-events:none;
}
.empty-state svg{
  width:56px;height:56px;
  color:var(--brand);
  position:relative;
}
.empty-state h3{margin:0;font-size:17px;font-weight:800;color:var(--ink);position:relative;letter-spacing:-.2px;}
.empty-state p{margin:0;font-size:13.5px;color:var(--muted);max-width:460px;position:relative;line-height:1.7;}

.hidden{display:none !important;}

/* =====================================================
   FOOTER
===================================================== */
.app-footer{
  padding:28px 32px 48px;text-align:center;
  font-size:12.5px;color:var(--faint);
  border-top:1px solid var(--line-2);
  margin-top:12px;
}
.app-footer strong{
  color:var(--brand-deep);
  font-weight:800;
}

/* Back to top */
.back-top{
  position:fixed;right:24px;bottom:24px;z-index:50;
  width:46px;height:46px;border-radius:14px;
  display:grid;place-items:center;
  padding:0;
  background:#ffffff;
  color:var(--brand-deep);
  border:1px solid var(--line);
  box-shadow:0 10px 24px -12px rgba(37,31,61,.4);
  cursor:pointer;
  opacity:0;pointer-events:none;
  transition:opacity .25s ease, transform .25s ease, box-shadow .25s ease;
  text-shadow:none;
}
.back-top.show{opacity:1;pointer-events:auto;}
.back-top:hover{
  transform:translateY(-2px);
  background:var(--brand);
  color:#fff;
  border-color:var(--brand);
  box-shadow:0 14px 28px -12px rgba(109,93,211,.75);
}
.back-top svg{width:18px;height:18px;}

/* =====================================================
   RESPONSIVE
===================================================== */
@media (max-width:1000px){
  .controls{grid-template-columns:1fr;}
}

@media (max-width:760px){
  .header-inner{
    padding:20px 20px;
    gap:18px;
  }
  .header-brand{gap:15px;}
  .header-text h1{font-size:18px;white-space:normal;}
  .header-text p{font-size:12px;}
  .header-kicker{font-size:9.5px;letter-spacing:1.1px;margin-bottom:7px;}
  .logo-badge{width:54px;height:54px;border-radius:16px;}
  .logo-fallback{font-size:17px;}
  .jk-logo{border-radius:14px;padding:4px;}
  .meta-chip{padding:9px 13px;border-radius:12px;}
  .meta-chip-text strong{font-size:12px;}
}

@media (max-width:700px){
  .container{padding:24px 18px 64px;}
  .card{padding:22px 20px;}
  .chart-wrapper{height:360px;}
  .chart-wrapper.tall{height:400px;}
  .kpi-value{font-size:21px;}
  .sku-bar{font-size:14px;padding:14px 16px;}
}

@media (max-width:560px){
  .header-meta{width:100%;}
  .meta-chip{flex:1 1 0;min-width:0;}
  .kpi-grid{grid-template-columns:repeat(auto-fit,minmax(150px,1fr));}
  .chart-wrapper{height:320px;}
  .chart-wrapper.tall{height:360px;}
  .export-group{width:100%;justify-content:flex-start;}
  .tol-btn{padding:8px 10px;font-size:11.5px;min-width:46px;}
}
</style>
</head>

<body>

<!-- =====================================================
     HEADER
====================================================== -->
<header class="app-header">
  <div class="header-glow"></div>
  <div class="header-grid"></div>

  <div class="header-inner">
    <div class="header-brand">
      <div class="logo-badge">
        <img src="static/jktyre-tyre-logo.png" alt="JK Tyre" class="jk-logo"
             onerror="this.style.display='none';document.getElementById('logoFallback').classList.add('show');">
        <span class="logo-fallback" id="logoFallback">JK</span>
      </div>

      <div class="header-text">
        <span class="header-kicker">JK Tyre · Quality Analytics</span>
        <h1>SKU Monthly <span class="accent">Running Weight</span> Analysis</h1>
        <p>Month-wise Spec vs Average Running Weight · Multi-sheet Excel intake</p>
      </div>
    </div>

    <div class="header-meta">
      <div class="meta-chip" id="todayChip">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span class="meta-chip-text">
          <small>Report Date</small>
          <strong>Loading…</strong>
        </span>
      </div>

      <div class="meta-chip live">
        <span class="live-dot"></span>
        <span class="meta-chip-text">
          <small>Status</small>
          <strong>Live</strong>
        </span>
      </div>
    </div>
  </div>

  <div class="header-rule"></div>
</header>

<main class="container">

  <!-- =================================================
       UPLOAD
  ================================================== -->
  <section class="card">
    <h2>Upload Monthly Excel</h2>
    <p>
      The workbook can contain multiple month-wise sheets. Every sheet must contain
      <strong>Size</strong>, <strong>Spec (kg)</strong> and <strong>Actual (kg)</strong>.
    </p>

    <div class="upload-meta">
      <span class="upload-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        Excel files <code>.xlsx</code> <code>.xls</code>
      </span>
      <span class="upload-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
        </svg>
        Multi-sheet supported
      </span>
      <span class="upload-meta-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Data shown as-is
      </span>
    </div>

    <form id="uploadForm" enctype="multipart/form-data">
      <div class="upload-area" id="dropZone">
        <div class="upload-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <p class="upload-title">Drag &amp; drop your Excel file here</p>
        <p class="upload-hint">or click to browse your device</p>
        <input type="file" id="file" name="file" accept=".xlsx,.xls" class="file-input">
        <div class="file-name" id="fileName"></div>
        <button type="submit" id="uploadBtn">Upload &amp; Analyze</button>
      </div>
    </form>

    <div id="status"></div>
  </section>

  <!-- =================================================
       ANALYSIS
  ================================================== -->
  <section class="card" id="analysisCard">
    <div class="card-head">
      <div class="card-title-group">
        <h2>SKU Monthly Running Weight Analysis</h2>
        <p class="section-note">
          Records are grouped by SKU and arranged chronologically by month. Supplied
          Spec, Actual, bucket counts, total tyres and % adherence values are shown
          exactly as received — nothing is recalculated. Missing months stay visible as
          <strong>No data</strong> and are never treated as zero.
        </p>
      </div>

      <!-- Export buttons -->
      <div class="export-group hidden" id="exportGroup">
        <button type="button" class="export-btn" data-kind="csv" id="exportCsvBtn" title="Download CSV">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="8" y1="13" x2="16" y2="13"/>
            <line x1="8" y1="17" x2="16" y2="17"/>
          </svg>
          CSV
        </button>

        <button type="button" class="export-btn" data-kind="word" id="exportWordBtn" title="Download Word document">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <path d="M8 13l2 6 2-6 2 6 2-6"/>
          </svg>
          Word
        </button>

        <button type="button" class="export-btn" data-kind="pdf" id="exportPdfBtn" title="Print / Save as PDF">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <path d="M9 15h1.5a1.5 1.5 0 0 0 0-3H9v6"/>
            <path d="M14 12v6"/>
            <path d="M14 12h2"/>
          </svg>
          PDF
        </button>
      </div>
    </div>

    <!-- Empty state -->
    <div class="empty-state" id="emptyState">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 3v18h18"/>
        <path d="M7 15l3.5-4 3 2.5L21 6"/>
      </svg>
      <h3>No data loaded yet</h3>
      <p>Upload a monthly Excel workbook above to explore SKU level running weight trends across every month.</p>
    </div>

    <!-- Analysis body -->
    <div id="analysisBody" class="hidden">

      <div class="controls">
        <div class="field">
          <label for="skuSelect">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            SKU / Size
          </label>
          <select id="skuSelect"><option value="">Upload Excel first</option></select>
        </div>
        <div class="field">
          <label>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="21" x2="4" y2="14"/>
              <line x1="4" y1="10" x2="4" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12" y2="3"/>
              <line x1="20" y1="21" x2="20" y2="16"/>
              <line x1="20" y1="12" x2="20" y2="3"/>
              <line x1="1" y1="14" x2="7" y2="14"/>
              <line x1="9" y1="8" x2="15" y2="8"/>
              <line x1="17" y1="16" x2="23" y2="16"/>
            </svg>
