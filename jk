function exportCsv() {
  if (!state.months.length) return;

  const limit = state.limit;
  const sign = limit > 0 ? "+" : "";

  const header = [
    "Month", "Spec (kg)", "Avg Running Weight (kg)", "Deviation (kg)",
    "Deviation (%)", "Lower (" + sign + limit + "%)", "Upper (" + sign + limit + "%)", "Status"
  ];

  const lines = [header.join(",")];

  state.months.forEach((m, i) => {
    const p = state.points[i];
    if (!p || !Number.isFinite(p.spec) || !Number.isFinite(p.avg)) {
      lines.push([formatMonthLabel(m), "No data", "", "", "", "", "", ""].join(","));
      return;
    }
    const lower = limitFromSpec(p.spec, -Math.abs(limit));
    const upper = limitFromSpec(p.spec,  Math.abs(limit));
    const dev = p.avg - p.spec;
    const devPct = p.spec !== 0 ? (dev / p.spec) * 100 : null;
    const ok = limit >= 0 ? dev <= (upper - p.spec) : dev >= (lower - p.spec);

    lines.push([
      formatMonthLabel(m),
      p.spec.toFixed(3),
