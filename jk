<script>
/* =========================================================
   CHART GLOBAL DEFAULTS
========================================================= */
Chart.defaults.font.family =
  "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif";
Chart.defaults.font.size = 12;
Chart.defaults.color = "#64748b";

/* =========================================================
   STATE
========================================================= */
let skuMonthlyChartInstance = null;
let dashboardData = null;

/* =========================================================
   HELPERS
========================================================= */
function n(v, d = 2) {
  const x = Number(v);
  return Number.isFinite(x) ? x.toFixed(d) : "—";
}

function signed(v, d = 3) {
  const x = Number(v);
  if (!Number.isFinite(x)) return "—";
  return (x >= 0 ? "+" : "") + x.toFixed(d);
}

function escapeHtml(value) {
  return String(value == null ? "" : value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function formatMonthLabel(value) {
  const m = String(value || "").match(/^(\d{4})-(\d{2})$/);
  if (!m) return value;
  const names = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return names[Number(m[2]) - 1] + "-" + m[1].slice(2);
}

function mean(arr) {
  const vals = arr.filter(v => Number.isFinite(v));
  if (!vals.length) return null;
  return vals.reduce((a, b) => a + b, 0) / vals.length;
}

/* =========================================================
   FILTERS
========================================================= */
function populateFilters(data) {
  const skuSelect = document.getElementById("skuSelect");
  const from = document.getElementById("fromMonth");
  const to = document.getElementById("toMonth");
  if (!skuSelect || !from || !to) return;

  const skus = data.sku_values || data.skus || [];
  const months =
    data.continuous_months ||
    data.month_values ||
    (data.meta && data.meta.months) ||
    [];

  skuSelect.innerHTML = skus.length
    ? skus.map(x => `<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`).join("")
    : `<option value="">No SKU found</option>`;

  const opts = months
    .map(x => `<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`)
    .join("");

  from.innerHTML = opts;
  to.innerHTML = opts;

  if (months.length) {
    from.value = months[0];
    to.value = months[months.length - 1];
  }
  if (skus.length) skuSelect.value = skus[0];
}

/* =========================================================
   KPI COMPUTATION
========================================================= */
function kpiIcon(tone) {
  if (tone === "is-ok") {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
  }
  if (tone === "is-bad") {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
  }
  if (tone === "is-info") {
    return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
  }
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>';
}

function computeKpis(selected, points) {
  const withData = points.filter(Boolean);

  const specVals = withData
    .map(r => r.spec == null ? null : Number(r.spec))
    .filter(Number.isFinite);
  const avgVals = withData
    .map(r => r.average_running_weight == null ? null : Number(r.average_running_weight))
    .filter(Number.isFinite);

  const avgSpec = mean(specVals);
  const avgRun = mean(avgVals);

  let devKg = null, devPct = null;
  if (avgSpec != null && avgRun != null && avgSpec !== 0) {
    devKg = avgRun - avgSpec;
    devPct = (devKg / avgSpec) * 100;
  }

  let within = 0, evaluated = 0;
  withData.forEach(r => {
    const spec = r.spec == null ? null : Number(r.spec);
    const run = r.average_running_weight == null ? null : Number(r.average_running_weight);
    const lo = r.minus_2_percent == null ? null : Number(r.minus_2_percent);
    const hi = r.plus_2_percent == null ? null : Number(r.plus_2_percent);
    if (!Number.isFinite(run)) return;
    evaluated++;
    if (Number.isFinite(lo) && Number.isFinite(hi)) {
      if (run >= Math.min(lo, hi) && run <= Math.max(lo, hi)) within++;
    } else if (Number.isFinite(spec) && spec !== 0) {
      const pct = ((run - spec) / spec) * 100;
      if (pct >= -2 && pct <= 2) within++;
    }
  });

  const compliance = evaluated ? (within / evaluated) * 100 : null;

  const devTone =
    devPct == null ? "is-neutral" :
    Math.abs(devPct) <= 2 ? "is-ok" : "is-bad";

  const compTone =
    compliance == null ? "is-neutral" :
    compliance >= 80 ? "is-ok" : "is-bad";

  return [
    {
      label: "Average Spec",
      value: avgSpec == null ? "—" : n(avgSpec, 3),
      unit: "kg",
      sub: specVals.length + " month" + (specVals.length === 1 ? "" : "s") + " with spec",
      tone: "is-neutral"
    },
    {
      label: "Avg Running Weight",
      value: avgRun == null ? "—" : n(avgRun, 3),
      unit: "kg",
      sub: avgVals.length + " month" + (avgVals.length === 1 ? "" : "s") + " with actuals",
      tone: "is-info"
    },
    {
      label: "Deviation",
      value: devPct == null ? "—" : (devPct >= 0 ? "+" : "") + devPct.toFixed(2),
      unit: "%",
      sub: devKg == null ? "—" : signed(devKg, 3) + " kg vs spec",
      tone: devTone
    },
    {
      label: "Months Covered",
      value: String(withData.length),
      unit: "/ " + selected.length,
      sub: selected.length - withData.length > 0
        ? (selected.length - withData.length) + " month(s) missing"
        : "Complete coverage",
      tone: "is-neutral"
    },
    {
      label: "Within ±2%",
      value: compliance == null ? "—" : compliance.toFixed(1),
      unit: "%",
      sub: within + " of " + evaluated + " month(s)",
      tone: compTone
    }
  ];
}

function renderKpis(selected, points) {
  const grid = document.getElementById("kpiGrid");
  if (!grid) return;
  const cards = computeKpis(selected, points);

  grid.innerHTML = cards.map(c =>
    '<div class="kpi ' + c.tone + '">' +
      '<div class="kpi-top">' +
        '<div class="kpi-label">' + escapeHtml(c.label) + '</div>' +
        '<div class="kpi-icon">' + kpiIcon(c.tone) + '</div>' +
      '</div>' +
      '<div class="kpi-value">' + escapeHtml(c.value) +
        '<span class="unit">' + escapeHtml(c.unit) + '</span>' +
      '</div>' +
      '<div class="kpi-sub">' + escapeHtml(c.sub) + '</div>' +
    '</div>'
  ).join("");
}

/* =========================================================
   SKU MONTHLY ANALYSIS
========================================================= */
function renderSkuAnalysis() {
  if (!dashboardData) return;

  const skuEl = document.getElementById("skuSelect");
  const fromEl = document.getElementById("fromMonth");
  const toEl = document.getElementById("toMonth");
  if (!skuEl || !fromEl || !toEl) return;

  const sku = skuEl.value;
  const from = fromEl.value;
  const to = toEl.value;

  const allMonths =
    dashboardData.continuous_months ||
    dashboardData.month_values ||
    (dashboardData.meta && dashboardData.meta.months) ||
    [];

  const monthly = dashboardData.sku_month_summary || [];
  const rows = monthly.filter(r => String(r.sku || "") === String(sku));

  let start = allMonths.indexOf(from);
  let end = allMonths.indexOf(to);
  if (start < 0) start = 0;
  if (end < 0) end = allMonths.length - 1;
  if (start > end) { const t = start; start = end; end = t; }

  const selected = allMonths.slice(start, end + 1);
  const byMonth = new Map(rows.map(r => [String(r.month), r]));
  const points = selected.map(m => byMonth.get(String(m)) || null);

  const missing = points
    .map((r, i) => (r ? null : i))
    .filter(i => i !== null);

  /* Selected SKU title */
  const title = document.getElementById("skuSelectedTitle");
  if (title) title.textContent = sku ? "Size / SKU: " + sku : "Select a SKU";

  /* Range meta */
  const rangeMeta = document.getElementById("skuRangeMeta");
  if (rangeMeta) {
    const withData = points.filter(Boolean);
    if (withData.length) {
      const first = formatMonthLabel(withData[0].month);
      const last = formatMonthLabel(withData[withData.length - 1].month);
      rangeMeta.textContent = first + " → " + last + " · " +
        withData.length + " of " + selected.length + " months";
    } else {
      rangeMeta.textContent = "";
    }
  }

  /* Missing info */
  const info = document.getElementById("skuMissingInfo");
  if (info) {
    if (missing.length) {
      info.classList.remove("hidden");
      info.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">' +
        '<circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>' +
        '<div><strong>Missing months:</strong> ' +
        missing.map(i => formatMonthLabel(selected[i])).map(escapeHtml).join(", ") +
        ' — shown as “No data” and excluded from all averages.</div>';
    } else {
      info.classList.add("hidden");
      info.innerHTML = "";
    }
  }

  /* KPI strip */
  renderKpis(selected, points);

  /* ---------- Chart ---------- */
  const ctx = document.getElementById("skuMonthlyChart");
  if (ctx) {
    if (skuMonthlyChartInstance) skuMonthlyChartInstance.destroy();

    const missingPlugin = {
      id: "missingMonthIndicator",
      afterDraw(chart) {
        if (!missing.length || !chart.scales.x) return;
        const c = chart.ctx;
        c.save();
        c.font = "700 11px Inter, Arial";
        c.textAlign = "center";
        c.fillStyle = "#94a3b8";

        missing.forEach(i => {
          const x = chart.scales.x.getPixelForValue(i);
          c.setLineDash([5, 5]);
          c.strokeStyle = "#cbd5e1";
          c.beginPath();
          c.moveTo(x, chart.chartArea.top);
          c.lineTo(x, chart.chartArea.bottom);
          c.stroke();
          c.setLineDash([]);

          c.fillText("No data", x, chart.chartArea.top + 16);
        });

        c.restore();
      }
    };

    skuMonthlyChartInstance = new Chart(ctx, {
      type: "line",
      plugins: [missingPlugin],
      data: {
        labels: selected.map(formatMonthLabel),
        datasets: [
          {
            label: "Average Running Weight",
            data: points.map(r => r ? Number(r.average_running_weight) : null),
            borderColor: "#e30613",
            backgroundColor: "rgba(227,6,19,.06)",
            borderWidth: 3,
            spanGaps: true,
            tension: 0.28,
            pointRadius: 5,
            pointHoverRadius: 9,
            pointBackgroundColor: "#e30613",
            pointBorderColor: "#ffffff",
            pointBorderWidth: 2.5,
            pointHoverBorderWidth: 3,
            fill: false
          },
          {
            label: "Spec",
            data: points.map(r => r ? Number(r.spec) : null),
            borderColor: "#0f172a",
            backgroundColor: "#0f172a",
            borderWidth: 2,
            borderDash: [6, 4],
            spanGaps: true,
            tension: 0.2,
            pointRadius: 3,
            pointHoverRadius: 6,
            pointBackgroundColor: "#0f172a",
            pointBorderColor: "#ffffff",
            pointBorderWidth: 2,
            fill: false
          },
          {
            label: "−2% Limit",
            data: points.map(r =>
              r && r.minus_2_percent != null ? Number(r.minus_2_percent) : null
            ),
            borderColor: "#f59e0b",
            backgroundColor: "#f59e0b",
            borderWidth: 1.8,
            borderDash: [3, 3],
            spanGaps: true,
            tension: 0.2,
            pointRadius: 2,
            pointHoverRadius: 5,
            pointBackgroundColor: "#f59e0b",
            fill: false
          },
          {
            label: "+2% Limit",
            data: points.map(r =>
              r && r.plus_2_percent != null ? Number(r.plus_2_percent) : null
            ),
            borderColor: "#2563eb",
            backgroundColor: "#2563eb",
            borderWidth: 1.8,
            borderDash: [3, 3],
            spanGaps: true,
            tension: 0.2,
            pointRadius: 2,
            pointHoverRadius: 5,
            pointBackgroundColor: "#2563eb",
            fill: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: "index", intersect: false },
        animation: {
          duration: 900,
          easing: "easeOutQuart"
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: "#64748b",
              font: { weight: "600", size: 11.5 }
            }
          },
          y: {
            grid: { color: "#eef2f7" },
            ticks: {
              color: "#64748b",
              font: { weight: "600", size: 11.5 }
            },
            title: {
              display: true,
              text: "Weight (kg)",
              color: "#475569",
              font: { weight: "700", size: 12 }
            }
          }
        },
        plugins: {
          legend: {
            display: true,
            position: "top",
            align: "end",
            labels: {
              usePointStyle: true,
              pointStyle: "line",
              boxWidth: 26,
              padding: 18,
              color: "#334155",
              font: { weight: "700", size: 12 }
            }
          },
          tooltip: {
            backgroundColor: "#0b1220",
            padding: 14,
            cornerRadius: 10,
            titleFont: { weight: "800", size: 13 },
            bodyFont: { weight: "600", size: 12.5 },
            bodySpacing: 6,
            boxPadding: 6,
            borderColor: "rgba(255,255,255,.08)",
            borderWidth: 1
          }
        }
      }
    });
  }

  /* ---------- Table ---------- */
  const tbody = document.getElementById("skuMonthTable");
  if (tbody) {
    tbody.innerHTML = "";

    if (!selected.length) {
      tbody.innerHTML =
        '<tr><td colspan="6" class="empty-cell">No months selected.</td></tr>';
      return;
    }

    selected.forEach((m, i) => {
      const r = points[i];

      if (!r) {
        tbody.insertAdjacentHTML("beforeend",
          '<tr class="missing-row">' +
            '<td>' + escapeHtml(formatMonthLabel(m)) + '</td>' +
            '<td colspan="5">No data</td>' +
          '</tr>');
        return;
      }

      const spec = r.spec == null ? null : Number(r.spec);
      const run = r.average_running_weight == null ? null : Number(r.average_running_weight);
      const lo = r.minus_2_percent == null ? null : Number(r.minus_2_percent);
      const hi = r.plus_2_percent == null ? null : Number(r.plus_2_percent);

      let ok = null;
      if (Number.isFinite(run) && Number.isFinite(lo) && Number.isFinite(hi)) {
        ok = run >= Math.min(lo, hi) && run <= Math.max(lo, hi);
      } else if (Number.isFinite(run) && Number.isFinite(spec) && spec !== 0) {
        const pct = ((run - spec) / spec) * 100;
        ok = pct >= -2 && pct <= 2;
      }

      const badge = ok === null
        ? '<span style="color:var(--faint);font-weight:700;">—</span>'
        : ok
          ? '<span class="badge ok">Within limit</span>'
          : '<span class="badge bad">Out of limit</span>';

      tbody.insertAdjacentHTML("beforeend",
        '<tr class="' + (ok === false ? "row-out" : "") + '">' +
          '<td>' + escapeHtml(formatMonthLabel(m)) + '</td>' +
          '<td>' + (spec == null ? "—" : n(spec, 3)) + '</td>' +
          '<td>' + (run == null ? "—" : n(run, 3)) + '</td>' +
          '<td>' + (lo == null ? "—" : n(lo, 3)) + '</td>' +
          '<td>' + (hi == null ? "—" : n(hi, 3)) + '</td>' +
          '<td>' + badge + '</td>' +
        '</tr>');
    });
  }
}

/* =========================================================
   INIT
========================================================= */
document.addEventListener("DOMContentLoaded", () => {

  /* ---------- Header date chip ---------- */
  const chip = document.getElementById("todayChip");
  if (chip) {
    const valueEl = chip.querySelector("strong");
    if (valueEl) {
      valueEl.textContent = new Date().toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric"
      });
    }
  }

  /* ---------- Elements ---------- */
  const form = document.getElementById("uploadForm");
  const fileInput = document.getElementById("file");
  const status = document.getElementById("status");
  const dropZone = document.getElementById("dropZone");
  const fileName = document.getElementById("fileName");
  const uploadBtn = document.getElementById("uploadBtn");
  const emptyState = document.getElementById("emptyState");
  const analysisBody = document.getElementById("analysisBody");

  /* ---------- File name display ---------- */
  function showFileName() {
    if (!fileName || !fileInput) return;
    if (fileInput.files && fileInput.files.length) {
      const f = fileInput.files[0];
      const kb = (f.size / 1024).toFixed(1);
      fileName.textContent = f.name + "  ·  " + kb + " KB";
      fileName.classList.add("show");
    } else {
      fileName.classList.remove("show");
    }
  }

  fileInput?.addEventListener("change", showFileName);

  /* ---------- Drag & drop ---------- */
  if (dropZone && fileInput) {
    ["dragenter", "dragover"].forEach(ev => {
      dropZone.addEventListener(ev, e => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.add("dragover");
      });
    });

    ["dragleave", "drop"].forEach(ev => {
      dropZone.addEventListener(ev, e => {
        e.preventDefault();
        e.stopPropagation();
        dropZone.classList.remove("dragover");
      });
    });

    dropZone.addEventListener("drop", e => {
      const files = e.dataTransfer && e.dataTransfer.files;
      if (files && files.length) {
        fileInput.files = files;
        showFileName();
      }
    });

    dropZone.addEventListener("click", e => {
      if (e.target.closest("#uploadBtn")) return;
      fileInput.click();
    });
  }

  /* ---------- SKU filters ---------- */
  document.getElementById("applySkuFilter")
    ?.addEventListener("click", () => renderSkuAnalysis());

  document.getElementById("skuSelect")
    ?.addEventListener("change", () => renderSkuAnalysis());

  document.getElementById("fromMonth")
    ?.addEventListener("change", () => renderSkuAnalysis());

  document.getElementById("toMonth")
    ?.addEventListener("change", () => renderSkuAnalysis());

  /* ---------- Upload ---------- */
  if (!form) return;

  form.addEventListener("submit", async e => {
    e.preventDefault();

    if (!fileInput.files.length) {
      status.textContent = "Please select an Excel file.";
      status.className = "error";
      return;
    }

    status.className = "loading";
    status.innerHTML = '<span class="spinner"></span> Processing Excel…';

    if (uploadBtn) {
      uploadBtn.disabled = true;
      uploadBtn.textContent = "Processing…";
    }

    try {
      const fd = new FormData();
      fd.append("file", fileInput.files[0]);

      const res = await fetch("/upload", {
        method: "POST",
        body: fd
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || data.error || "Failed to process Excel."
        );
      }

      dashboardData = data;

      populateFilters(data);

      if (emptyState) emptyState.classList.add("hidden");
      if (analysisBody) analysisBody.classList.remove("hidden");

      requestAnimationFrame(() => renderSkuAnalysis());

      status.textContent = data.message || "Excel processed successfully.";
      status.className = "success";

    } catch (err) {
      console.error(err);
      status.textContent = err.message;
      status.className = "error";
    } finally {
      if (uploadBtn) {
        uploadBtn.disabled = false;
        uploadBtn.textContent = "Upload & Analyze";
      }
    }
  });

});
</script>

