/* =========================================================
   INIT
========================================================= */
document.addEventListener("DOMContentLoaded", () => {

  /* Header date */
  const chip = document.getElementById("todayChip");
  if (chip) {
    const valueEl = chip.querySelector("strong");
    if (valueEl) {
      valueEl.textContent = new Date().toLocaleDateString("en-IN", {
        day: "2-digit", month: "short", year: "numeric"
      });
    }
  }

  /* Build tolerance buttons */
  buildToleranceControl();

  const form = document.getElementById("uploadForm");
  const fileInput = document.getElementById("file");
  const status = document.getElementById("status");
  const dropZone = document.getElementById("dropZone");
  const fileName = document.getElementById("fileName");
  const uploadBtn = document.getElementById("uploadBtn");
  const emptyState = document.getElementById("emptyState");
  const analysisBody = document.getElementById("analysisBody");
  const exportGroup = document.getElementById("exportGroup");

  function showFileName() {
    if (!fileName || !fileInput) return;
    if (fileInput.files && fileInput.files.length) {
      const f = fileInput.files[0];
      fileName.textContent = f.name + "  ·  " + (f.size / 1024).toFixed(1) + " KB";
      fileName.classList.add("show");
    } else {
      fileName.classList.remove("show");
    }
  }
  fileInput?.addEventListener("change", showFileName);

  if (dropZone && fileInput) {
    ["dragenter", "dragover"].forEach(ev => {
      dropZone.addEventListener(ev, e => {
        e.preventDefault(); e.stopPropagation();
        dropZone.classList.add("dragover");
      });
    });
    ["dragleave", "drop"].forEach(ev => {
      dropZone.addEventListener(ev, e => {
        e.preventDefault(); e.stopPropagation();
        dropZone.classList.remove("dragover");
      });
    });
    dropZone.addEventListener("drop", e => {
      const files = e.dataTransfer && e.dataTransfer.files;
      if (files && files.length) {
        fileInput.files = files;
        showFileName();
      }
    });
    dropZone.addEventListener("click", e => {
      if (e.target.closest("#uploadBtn")) return;
      fileInput.click();
    });
  }

  /* Filters */
  document.getElementById("applySkuFilter")?.addEventListener("click", renderSkuAnalysis);
  document.getElementById("skuSelect")?.addEventListener("change", renderSkuAnalysis);
  document.getElementById("fromMonth")?.addEventListener("change", renderSkuAnalysis);
  document.getElementById("toMonth")?.addEventListener("change", renderSkuAnalysis);

  /* Export buttons */
  document.getElementById("exportCsvBtn")?.addEventListener("click", () => {
    if (state.busy) return;
    exportCsv();
  });
  document.getElementById("exportWordBtn")?.addEventListener("click", async () => {
    if (state.busy) return;
    setBusy(true, "word");
    try { await exportWord(); }
    catch (err) { console.error(err); alert("Word export failed: " + (err && err.message ? err.message : err)); }
    finally { setTimeout(() => setBusy(false), 400); }
  });
  document.getElementById("exportPdfBtn")?.addEventListener("click", () => {
    if (state.busy) return;
    setBusy(true, "pdf");
    try { exportPdf(); }
    finally { setTimeout(() => setBusy(false), 900); }
  });

  if (!form) return;

  form.addEventListener("submit", async e => {
    e.preventDefault();

    if (!fileInput.files.length) {
      status.textContent = "Please select an Excel file.";
      status.className = "error";
      return;
    }

    status.className = "loading";
    status.innerHTML = '<span class="spinner"></span> Processing Excel…';

    if (uploadBtn) {
      uploadBtn.disabled = true;
      uploadBtn.textContent = "Processing…";
    }

    try {
      const fd = new FormData();
      fd.append("file", fileInput.files[0]);

      const res = await fetch("/upload", { method: "POST", body: fd });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || data.error || "Failed to process Excel.");
      }

      dashboardData = data;
      populateFilters(data);

      if (emptyState) emptyState.classList.add("hidden");
      if (analysisBody) analysisBody.classList.remove("hidden");
      if (exportGroup) exportGroup.classList.remove("hidden");

      requestAnimationFrame(() => renderSkuAnalysis());

      status.textContent = data.message || "Excel processed successfully.";
      status.className = "success";

    } catch (err) {
      console.error(err);
      status.textContent = err.message;
      status.className = "error";
    } finally {
      if (uploadBtn) {
        uploadBtn.disabled = false;
        uploadBtn.textContent = "Upload & Analyze";
      }
    }
  });
});
</script>

