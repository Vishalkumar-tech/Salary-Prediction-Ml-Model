                    }

                }

            }

        });

    }



    /\* ---------- SKU month table ---------- \*/



    const tbody = document.getElementById("skuMonthTable");



    if (tbody) {



        tbody.innerHTML = "";



        if (!selected.length) {

            tbody.innerHTML =

                \`\<tr>\<td colspan="5" class="empty-cell">No months selected.\</td>\</tr>\`;

        } else {

            selected.forEach((m, i) => {



                const r = points[i];



                if (!r) {

                    tbody.insertAdjacentHTML("beforeend",

                        \`\<tr class="missing-row">

                            \<td>\<strong>${escapeHtml(formatMonthLabel(m))}\</strong>\</td>

                            \<td colspan="4">No data\</td>

                        \</tr>\`);

                    return;

                }



                tbody.insertAdjacentHTML("beforeend",

                    \`\<tr>

                        \<td>${escapeHtml(formatMonthLabel(m))}\</td>

                        \<td>${r.spec == null ? "—" : n(r.spec, 3)}\</td>

                        \<td>${r.average_running_weight == null ? "—" : n(r.average_running_weight, 3)}\</td>

                        \<td>${r.minus_2_percent == null ? "—" : n(r.minus_2_percent, 3)}\</td>

                        \<td>${r.plus_2_percent == null ? "—" : n(r.plus_2_percent, 3)}\</td>

                    \</tr>\`);

            });

        }

